---
// Section 01 of the WE THE PEOPLE slide deck (3rd June 2026, To Share) — text only,
// one 70ch column. The words live in src/content/idea.yml, which is what the
// CMS at /admin edits.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Prose from '../components/Prose.astro';
import { idea } from '../lib/content';
---

<Layout title={idea.page_title} introLines={idea.title_lines}>
  <PageHero lines={idea.title_lines}>
    <p class="hero__kicker fade-up">{idea.kicker}</p>
  </PageHero>

  <Prose blocks={idea.blocks} links={idea.links} />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var back = document.querySelector('article.prose .back');
    if (!back) return;
    var fired = false;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && !fired) {
          fired = true;
          window.posthog?.capture('idea_article_read');
          observer.disconnect();
        }
      });
    }, { threshold: 0.5 });
    observer.observe(back);
  });
</script>
