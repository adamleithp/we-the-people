---
/**
 * Design trial for the homepage: white ground, WE THE PEOPLE and the opening
 * words on the left, Britain in contour lines in the middle, the three parts
 * on the right, and I'm In below.
 *
 * The map is glass, broken like a struck pane (`impact()`): spokes out from
 * one point in the Midlands, rings across them, slivers at the hit and big
 * plates at the edge. The pieces barely part, as a cracked window does. It
 * opens whole and shatters as the first part arrives (see the entrance notes
 * below); it joins while the opening words or a part is in hand, and turns
 * gold while "I'm In" is.
 *
 * Each shard follows the intro's rule: a box the size of its own piece, with
 * a map-sized inner wrapper offset back into place. The map's paths are
 * inlined once as a <symbol>; every shard draws it with <use>. Pieces that
 * are only sea are dropped at build time.
 *
 * Unlinked and noindex while we compare it with the current homepage.
 * The map is generated by scripts/build-britain-map.mjs.
 */
import { Font } from 'astro:assets';
import '../styles/base.css';
import PostHog from '../components/posthog.astro';
import AtlasJoin from '../components/AtlasJoin.astro';
import britain from '../assets/britain-topo.svg?raw';
import { impact, mulberry32 } from '../lib/shards';

/* --- the entrance ----------------------------------------------------------
   The map fades in whole; the opening words arrive one at a time, the three
   highlighted phrases sweeping in with them; then the wordmark; then the parts,
   one after another, and the map shatters as the first of them lands. Each
   highlight lets go as its own part arrives. The button comes last. */
const T_WORDS = 0.8; // s, the first word
const T_STEP = 0.055; // s, between words
const T_PART_GAP = 0.4; // s, between parts

/* the opening words, with the phrase each part lights up when it's hovered.
   Split into words so each can arrive on its own, and so the highlight follows
   a phrase across a line break. */
const CREED: Array<{ text: string; hl?: 'problem' | 'hope' | 'part' }> = [
  { text: 'Britain is in crisis', hl: 'problem' },
  { text: '. We The People is a' },
  { text: 'vision of how we can change', hl: 'hope' },
  { text: 'our fortunes – and our future –' },
  { text: 'together', hl: 'part' },
  { text: '. The task is enormous. This is how it begins.' },
];
let wordN = 0;
const creed = CREED.map((seg) => ({
  hl: seg.hl,
  words: seg.text
    .replace(/^\. /, '.\u0000')
    .split(/[ \u0000]/)
    .map((w) => ({ w, d: T_WORDS + wordN++ * T_STEP })),
}));
const T_MARK = T_WORDS + wordN * T_STEP + 0.25;
const T_PARTS = T_MARK + 0.7;
const T_CTA = T_PARTS + 2 * T_PART_GAP + 0.5;
const PART_INDEX = { problem: 0, hope: 1, part: 2 };
const timeline = `--t-mark:${T_MARK.toFixed(2)}s;--t-parts:${T_PARTS.toFixed(2)}s;--t-gap:${T_PART_GAP}s;--t-cta:${T_CTA.toFixed(2)}s`;

/* --- the glass map, worked out at build time ------------------------------ */

const VIEW_W = 600;
const VIEW_H = 1000;
const paths = britain.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');

// the coastline as polygons, to tell land triangles from sea ones
const coastD = /class="coast" d="([^"]+)"/.exec(britain)![1];
const rings = coastD
  .split('M')
  .filter(Boolean)
  .map((ring) =>
    ring
      .replace(/Z/g, '')
      .split('L')
      .map((pt) => pt.split(',').map(Number) as [number, number]),
  );
const inPolygon = (x: number, y: number, poly: Array<[number, number]>) => {
  let inside = false;
  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
    const [xi, yi] = poly[i];
    const [xj, yj] = poly[j];
    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
  }
  return inside;
};
// even-odd across every ring, so lakes and islands-in-lakes come out right
const onLand = (x: number, y: number) => rings.reduce((inside, ring) => inside !== inPolygon(x, y, ring), false);
const coastPts = rings.flat();

// where the pane was struck, in % of the map: the Midlands
const HIT = [52, 60];

// keep a piece if land is under its middle or any coastline runs through it
const rnd = mulberry32(5150);
const rand = (a: number, b: number) => a + rnd() * (b - a);
const glass = impact(VIEW_W / VIEW_H, HIT[0], HIT[1], 20261004, {
  spokes: 24,
  radii: [0, 3, 7, 12, 18, 26, 35, 46, 59, 75, 120],
})
  .filter((s) => {
    const poly = s.pts.map(([x, y]) => [(x / 100) * VIEW_W, (y / 100) * VIEW_H] as [number, number]);
    return onLand((s.cx / 100) * VIEW_W, (s.cy / 100) * VIEW_H) || coastPts.some(([x, y]) => inPolygon(x, y, poly));
  })
  .map((s) => {
    // a cracked pane: each piece slips a few px out from the hit, tips a few
    // degrees, and sinks or lifts a touch; the slivers near the hit most
    const near = Math.max(0, 1 - s.dist / 45);
    // big plates out at the rim would swing far on any real tilt
    const tip = (0.35 + near) * rand(4, 10);
    const slip = rand(3, 9) + near * rand(4, 12);
    const tx = s.ux * slip + rand(-1.5, 1.5);
    const ty = s.uy * slip + rand(-1.5, 1.5);
    return {
      ...s,
      broken: `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, ${rand(-26, 8).toFixed(0)}px) rotateX(${(s.uy * tip).toFixed(1)}deg) rotateY(${(-s.ux * tip).toFixed(1)}deg) rotateZ(${(rand(-2.5, 2.5) * (0.4 + near)).toFixed(1)}deg)`,
      // the break heals from the hit outwards
      join: (s.dist * 0.006).toFixed(3),
      edge: s.outline.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(' '),
      // the map-sized wrapper inside the shard's own box (see shatter())
      inner: `left:${s.ox.toFixed(4)}%;top:${s.oy.toFixed(4)}%;width:${s.sw.toFixed(4)}%;height:${s.sh.toFixed(4)}%`,
      part: rand(0, 0.25).toFixed(3),
      // how this piece folds away from the pointer (see the script below)
      push: rand(14, 34).toFixed(1),
      dz: rand(20, 90).toFixed(0),
      tilt: rand(10, 26).toFixed(1),
      spin: rand(-12, 12).toFixed(1),
    };
  });

const SECTIONS = [
  {
    key: 'problem',
    title: 'Our Real Problem',
    blurb:
      'We all have opinions on what needs to be done. But there is a deeper threat which almost no-one is trying to fix.',
    href: '/problem',
  },
  {
    key: 'hope',
    title: 'Our Real Hope',
    blurb:
      'Both ancient and new, a practical plan for how we overcome our divisions and start to turn things around.',
    href: '/hope',
  },
  {
    key: 'part',
    title: 'Be Part of It',
    blurb:
      'Here are ways to help make it happen by yourself, in your community and for our country.',
    href: '/be-part-of-it',
  },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-suwannaphum" preload />
    <Font cssVariable="--font-lateef" preload />
    <title>We The People</title>
    <PostHog />
  </head>
  <body class="atlas" style={timeline}>
    <main class="atlas__stage" data-glass="whole">
      <div class="atlas__intro">
        <h1 class="atlas__mark">We The People</h1>
        {/* written tight on purpose: any line break in here is a space on the page */}
        <p class="atlas__creed">
          {creed.map((seg, i) => {
            const words = seg.words.map((w, j) => <>{j > 0 && w.w !== '.' && ' '}<span class={seg.hl ? 'cw hl__w' : 'cw'} style={`--d:${w.d.toFixed(3)}s;--w:${j}`}>{w.w}</span></>);
            const gap = i > 0 && seg.words[0].w !== '.' && ' ';
            return seg.hl
              ? <>{gap}<span class={`hl hl--${seg.hl}`} style={`--until:calc(var(--t-parts) + ${PART_INDEX[seg.hl]} * var(--t-gap))`}>{words}</span></>
              : <>{gap}{words}</>;
          })}
        </p>
        <span class="magnet" data-magnet="0.3"><a class="atlas__cta" href="#im-in">I'm In</a></span>
      </div>

      <div class="atlas__map glassmap" role="img" aria-label="A map of the United Kingdom">
        <svg class="glassmap__defs" aria-hidden="true">
          <symbol id="uk" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} set:html={paths} />
          {/* the same map in gold: dawn land under deep-gold contours */}
          <symbol id="uk-gold" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}>
            <path d={coastD} fill="#F2C14E" stroke="none" />
            <g set:html={paths} />
          </symbol>
        </svg>
        {
          glass.map((s) => (
            <div
              class="gpiece"
              aria-hidden="true"
              data-cx={s.cx.toFixed(2)}
              data-cy={s.cy.toFixed(2)}
              data-push={s.push}
              data-dz={s.dz}
              data-tilt={s.tilt}
              data-spin={s.spin}
              style={`left:${s.bx.toFixed(4)}%;top:${s.by.toFixed(4)}%;width:${s.bw.toFixed(4)}%;height:${s.bh.toFixed(4)}%;transform-origin:${s.origin}`}
            >
            <div
              class="gshard"
              style={`clip-path:${s.clip};transform-origin:${s.origin};--broken:${s.broken};--join:${s.join}s;--part:${s.part}s`}
            >
              <svg class="gshard__in" style={s.inner} viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}>
                <use href="#uk" />
              </svg>
              {/* the gold copy, in a box the size of the shard: the layer it gets
                  for its fade is then the shard's size, not the whole map's */}
              <div class="gshard__gold">
                <svg class="gshard__in" style={s.inner} viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}>
                  <use href="#uk-gold" />
                </svg>
              </div>
              <svg class="gshard__edge" viewBox="0 0 100 100" preserveAspectRatio="none">
                <polygon points={s.edge} />
              </svg>
            </div>
            </div>
          ))
        }
        {/* the glint: a band of light across the gold land, over the glass */}
        <svg class="glassmap__shine" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} aria-hidden="true">
          <defs>
            <clipPath id="uk-land">
              <path d={coastD} />
            </clipPath>
            <linearGradient id="uk-glint" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity="0" />
              <stop offset="0.5" stop-color="#fff" stop-opacity="0.32" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
          </defs>
          <g clip-path="url(#uk-land)">
            <g transform={`rotate(20 ${VIEW_W / 2} ${VIEW_H / 2})`}>
              <rect class="glassmap__glint" x="-400" y="-300" width="320" height={VIEW_H + 600} fill="url(#uk-glint)" />
            </g>
          </g>
        </svg>
      </div>

      <nav class="atlas__parts" aria-label="The story">
        {
          SECTIONS.map((s, i) => (
            <a class={`part part--${s.key}`} href={s.href} style={`--i:${i}`}>
              <span class="part__in magnet" data-magnet="0.12">
                <span class="part__title">{s.title}</span>
                <span class="part__blurb">{s.blurb}</span>
                <span class="part__cta">
                  Read <span aria-hidden="true">→</span>
                </span>
              </span>
            </a>
          ))
        }
      </nav>
    </main>

    <AtlasJoin />

    <script>
      /* --- the map's state ------------------------------------------------------
         One attribute on the stage drives the glass: `whole` while the entrance
         plays, then `broken` at rest, `joined` while the opening words or a part
         is in hand, `gold` while "I'm In" is. Worked out here from :hover and
         focus rather than in CSS with :has(), which re-matched every shard
         whenever hover moved anywhere on the stage. */
      const stage = document.querySelector<HTMLElement>('.atlas__stage')!;
      const intro = stage.querySelector<HTMLElement>('.atlas__intro')!;
      const cta = stage.querySelector<HTMLElement>('.atlas__cta')!;
      const parts = [...stage.querySelectorAll<HTMLElement>('.part')];
      let shattered = false;

      const held = (el: HTMLElement) => el.matches(':hover, :focus-visible');
      const settle = () => {
        stage.dataset.glass = !shattered
          ? 'whole'
          : held(cta)
            ? 'gold'
            : intro.matches(':hover') || parts.some(held)
              ? 'joined'
              : 'broken';
      };
      for (const el of [intro, cta, ...parts])
        for (const type of ['pointerenter', 'pointerleave', 'focusin', 'focusout'])
          el.addEventListener(type, settle);

      /* The shatter: the map breaks the moment the first part, Our Real Problem,
         starts to come in. Keyed off that part's own animationstart so it stays
         in step with the CSS timeline, with the clock as a fallback for when
         there's no animation to wait for (reduced motion). */
      const shatter = () => {
        if (shattered) return;
        shattered = true;
        settle();
      };
      parts[0].addEventListener('animationstart', (e) => e.target === parts[0] && shatter());
      setTimeout(shatter, parseFloat(getComputedStyle(document.body).getPropertyValue('--t-parts')) * 1000 + 100);

      /* --- the pointer -------------------------------------------------------
         One listener and one frame loop for both things that follow the mouse:
         - the glass folds away from it, as the live titles do (ShatterTitle):
           each piece inside a circle round the cursor is pushed out, tipped and
           lifted, easing its own amount toward the falloff;
         - magnetic links lean toward it by their [data-magnet] fraction, capped.
         Boxes are read only when scroll or resize has moved them, all reads
         before any writes. Direct style.transform writes only; the loop stops
         once everything is at rest. */
      const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fine && !still) {
        const map = stage.querySelector<HTMLElement>('.glassmap')!;
        const num = (el: HTMLElement, key: string) => Number(el.dataset[key]) || 0;
        const smooth = (t: number) => t * t * (3 - 2 * t);
        const pieces = [...map.querySelectorAll<HTMLElement>('.gpiece')].map((el) => ({
          el,
          cx: num(el, 'cx') / 100,
          cy: num(el, 'cy') / 100,
          push: num(el, 'push'),
          dz: num(el, 'dz'),
          tilt: num(el, 'tilt'),
          spin: num(el, 'spin'),
          k: 0,
        }));
        const REACH = 70; // px beyond a magnet's edge where the pull begins
        const CAP = 12; // px, the furthest a magnet moves
        const magnets = [...document.querySelectorAll<HTMLElement>('[data-magnet]')].map((el) => ({
          el,
          k: num(el, 'magnet'),
          cx: 0,
          cy: 0,
          hw: 0,
          hh: 0,
          x: 0,
          y: 0,
        }));

        let px = -1e5;
        let py = -1e5;
        let box = map.getBoundingClientRect();
        let dirty = true;
        let running = false;
        let live = false;

        // a magnet's resting box: its rect less the lean it currently has on
        const measure = () => {
          box = map.getBoundingClientRect();
          for (const m of magnets) {
            const r = m.el.getBoundingClientRect();
            m.cx = r.left + r.width / 2 - m.x;
            m.cy = r.top + r.height / 2 - m.y;
            m.hw = r.width / 2 + REACH;
            m.hh = r.height / 2 + REACH;
          }
          dirty = false;
        };

        const frame = () => {
          if (dirty) measure();
          let busy = false;

          const radius = box.width * 0.4 || 1;
          for (const p of pieces) {
            const dx = box.left + p.cx * box.width - px;
            const dy = box.top + p.cy * box.height - py;
            const dist = Math.hypot(dx, dy) || 0.001;
            const t = dist < radius ? smooth(1 - dist / radius) : 0;
            const k = p.k + (t - p.k) * 0.14;
            if (k < 0.002) {
              if (p.k) p.el.style.transform = '';
              p.k = 0;
              continue;
            }
            p.k = k;
            busy = true;
            const ux = dx / dist;
            const uy = dy / dist;
            p.el.style.transform =
              `translate3d(${(ux * p.push * k).toFixed(2)}px,${(uy * p.push * k).toFixed(2)}px,${(p.dz * k).toFixed(1)}px)` +
              ` rotateX(${(uy * p.tilt * k).toFixed(2)}deg)` +
              ` rotateY(${(-ux * p.tilt * k).toFixed(2)}deg)` +
              ` rotate(${(p.spin * k).toFixed(2)}deg)`;
          }
          if (busy !== live) {
            live = busy;
            map.classList.toggle('is-live', live); // will-change on the whole map, once
          }

          for (const m of magnets) {
            const dx = px - m.cx;
            const dy = py - m.cy;
            const near = Math.abs(dx) < m.hw && Math.abs(dy) < m.hh;
            const tx = near ? Math.max(-CAP, Math.min(CAP, dx * m.k)) : 0;
            const ty = near ? Math.max(-CAP, Math.min(CAP, dy * m.k)) : 0;
            const x = m.x + (tx - m.x) * 0.18;
            const y = m.y + (ty - m.y) * 0.18;
            const rest = Math.abs(tx - x) < 0.05 && Math.abs(ty - y) < 0.05;
            if (!rest) busy = true;
            if (rest && m.x === tx && m.y === ty) continue;
            m.x = rest ? tx : x;
            m.y = rest ? ty : y;
            m.el.style.transform = `translate(${m.x.toFixed(2)}px, ${m.y.toFixed(2)}px)`;
          }

          // keep going while anything moves, or while the cursor is near the map
          const reach = radius;
          const near =
            px > box.left - reach && px < box.right + reach && py > box.top - reach && py < box.bottom + reach;
          running = busy || near;
          if (running) requestAnimationFrame(frame);
        };
        const kick = () => {
          if (running) return;
          running = true;
          requestAnimationFrame(frame);
        };

        addEventListener(
          'pointermove',
          (e) => {
            if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
            px = e.clientX;
            py = e.clientY;
            kick();
          },
          { passive: true },
        );
        document.addEventListener('pointerleave', () => {
          px = py = -1e5;
          kick();
        });
        const moved = () => (dirty = true);
        addEventListener('scroll', moved, { passive: true });
        addEventListener('resize', moved);
        // the entrance moves things; read the boxes again once it's over
        document.body.addEventListener('animationend', moved);
      }
    </script>
  </body>
</html>

<style>
  :global(body.atlas) {
    --atlas-ink: var(--color-wtp-racing);
    --atlas-muted: #8a958e;
    --atlas-text: #2c3f33; /* reading text: dark enough to sound sure of itself */
    --atlas-serif: var(--font-suwannaphum), Georgia, serif;
    background: #fff;
    color: var(--atlas-ink);
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }

  .atlas__mark {
    font-family: var(--font-lateef), Georgia, serif;
    font-weight: 800;
    /* base.css sets antialiased, which on macOS drops the stem thickening and
       renders this bold a weight lighter than Google's own specimen */
    -webkit-font-smoothing: auto;
    -moz-osx-font-smoothing: auto;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 4.6vw, 4.2rem);
    line-height: 0.9;
    letter-spacing: 0.03em;
    white-space: nowrap;
    margin-bottom: 1.25rem;
    animation: atlas-in 0.9s var(--ease-out) var(--t-mark) both;
  }

  .atlas__stage {
    flex: 1;
    min-height: 100svh;
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) 1rem 5rem;
  }

  .atlas__cta {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    background: var(--color-wtp-dawn);
    color: var(--color-wtp-ink);
    font-family: var(--atlas-serif);
    font-size: 0.9rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    animation: atlas-in 0.9s var(--ease-out) var(--t-cta) both;
    transition: transform 0.2s var(--ease-out);
  }
  .atlas__cta:active {
    transform: scale(0.97);
  }
  .atlas__cta:focus-visible {
    outline: 2px solid var(--atlas-ink);
    outline-offset: 3px;
  }

  /* --- the highlighter -------------------------------------------------------
     A dawn stroke behind each word, swept in left to right by scaleX, one word
     after the next. Per word rather than per phrase so a phrase that wraps
     still highlights on both lines. */
  .hl__w,
  .part__cta {
    position: relative;
  }
  .hl__w::before,
  .part__cta::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0.12em -0.14em 0.02em;
    background: var(--color-wtp-dawn);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.18s ease;
  }
  /* bridge the space to the next word, so the stroke reads as one */
  .hl__w:not(:last-child)::before {
    right: -0.42em;
  }
  .atlas__stage:has(.part--problem:is(:hover, :focus-visible)) .hl--problem .hl__w::before,
  .atlas__stage:has(.part--hope:is(:hover, :focus-visible)) .hl--hope .hl__w::before,
  .atlas__stage:has(.part--part:is(:hover, :focus-visible)) .hl--part .hl__w::before,
  .part:is(:hover, :focus-visible) .part__cta::before {
    transform: none;
    transition: transform 0.32s var(--ease-out) calc(var(--w, 0) * 70ms);
  }

  .atlas__creed {
    isolation: isolate;
    max-width: 30ch;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.7;
    text-wrap: pretty;
    color: var(--atlas-text);
  }
  /* each word rises in on its own beat */
  .cw {
    display: inline-block;
    animation: word-in 0.6s var(--ease-out) var(--d) both;
  }
  /* the highlighted phrases sweep in with their words and let go as their part
     arrives. Their own pseudo-element, so the hover stroke (::before) is never
     held by an animation fill. */
  .hl__w::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0.12em -0.14em 0.02em;
    background: var(--color-wtp-dawn);
    transform-origin: left center;
    animation:
      hl-in 0.4s var(--ease-out) calc(var(--d) + 0.12s) both,
      hl-out 0.6s ease var(--until) both;
  }
  .hl__w:not(:last-child)::after {
    right: -0.42em;
  }
  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
  }
  @keyframes hl-in {
