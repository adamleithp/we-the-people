---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Join Us — We The People">
  <main class="join-page">
    <p class="kicker">We The People</p>
    <h1>Be part of hope.</h1>
    <p class="lede">
      Reunite the country. Transform the system. It starts with people like you standing
      together — sign-ups open soon.
    </p>
    <!-- TODO: wire to the chosen sign-up service (Mailchimp / Action Network / …) -->
    <form class="signup" onsubmit="return false">
      <label class="sr-only" for="email">Email address</label>
      <input id="email" type="email" name="email" placeholder="you@example.com" required />
      <button type="submit" disabled title="Sign-ups open soon">Join Us</button>
    </form>
    <a class="back" href="/">← Back to the film</a>
  </main>
</Layout>

<style>
  .join-page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    padding: 8vh 6vw;
    text-align: center;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 0.85rem;
    color: var(--color-wtp-dawn, #f2c14e);
  }
  h1 {
    margin: 0;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 9vw, 6rem);
    line-height: 0.95;
  }
  .lede {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1rem, 2.6vw, 1.2rem);
    line-height: 1.55;
    opacity: 0.9;
  }
  .signup {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }
  .signup input {
    padding: 0.85rem 1.2rem;
    min-width: min(20rem, 70vw);
    border: 1px solid rgba(246, 244, 238, 0.35);
    border-radius: 999px;
    background: rgba(246, 244, 238, 0.08);
    color: var(--color-wtp-paper, #f6f4ee);
    font-size: 1rem;
  }
  .signup input::placeholder {
    color: rgba(246, 244, 238, 0.5);
  }
  .signup button {
    padding: 0.85rem 2.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-wtp-paper, #f6f4ee);
    color: var(--color-wtp-green, #004225);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 1rem;
  }
  .signup button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .back {
    margin-top: 1.6rem;
    color: rgba(246, 244, 238, 0.7);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back:hover {
    color: var(--color-wtp-paper, #f6f4ee);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
