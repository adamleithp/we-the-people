---
// Section 02 of the WE THE PEOPLE slide deck (3rd June 2026, To Share) — text only,
// one 70ch column. The words live in src/content/practice.yml, which is what the
// CMS at /admin edits.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Prose from '../components/Prose.astro';
import { practice } from '../lib/content';
---

<Layout title={practice.page_title} introLines={practice.title_lines}>
  <PageHero lines={practice.title_lines}>
    <p class="hero__kicker fade-up">{practice.kicker}</p>
  </PageHero>

  <Prose blocks={practice.blocks} links={practice.links} />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var backs = document.querySelectorAll('article.prose .back');
    var lastBack = backs[backs.length - 1];
    if (!lastBack) return;
    var fired = false;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && !fired) {
          fired = true;
          window.posthog?.capture('practice_article_read');
          observer.disconnect();
        }
      });
    }, { threshold: 0.5 });
    observer.observe(lastBack);
  });
</script>
