---
import Layout from '../layouts/Layout.astro';
---

<Layout title="We The People — Where can we find our hope?">
  <!-- Fixed stage: the movie renders here; the tall track below drives scroll -->
  <canvas id="movie"></canvas>

  <!-- Beat 1 — plain white title card, fades to reveal the scene -->
  <div id="title-card" class="title-card">
    <p class="title-card-words">Where can we<br />find our hope?</p>
  </div>

  <!-- The storyboard WORDS, driven by scroll progress -->
  <p id="caption" class="caption"></p>

  <!-- First-scroll nudge -->
  <div id="scroll-hint" class="scroll-hint">
    <span>Scroll</span>
    <span class="chev">⌄</span>
  </div>

  <!-- Arrival CTA (sign-ups are the point) -->
  <div id="join" class="join">
    <p class="join-tag">Be part of hope.</p>
    <a class="join-cta" href="/join">Join Us</a>
  </div>

  <!-- Scroll track: gives the document real height so the page scrubs the movie -->
  <div id="track" class="track" aria-hidden="true"></div>
</Layout>

<script>
  import { startMovie } from '../scripts/movie';
  startMovie();
</script>

<style>
  #movie {
    position: fixed;
    inset: 0;
    display: block;
    width: 100vw;
    height: 100dvh;
    z-index: 0;
    background: #0a1522; /* pre-paint before first frame */
  }

  /* Scroll track — height set in CSS, read by the engine to map scroll → progress */
  .track {
    position: relative;
    width: 1px;
    height: 900vh;
    pointer-events: none;
  }

  /* Beat 1 — white title card over everything, fades out early */
  .title-card {
    position: fixed;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f6f4ee;
    will-change: opacity;
  }
  .title-card-words {
    margin: 0;
    padding: 0 6vw;
    text-align: center;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    color: var(--color-wtp-green, #004225);
    font-size: clamp(2.4rem, 8vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: 0.01em;
  }

  /* Storyboard WORDS — light, tracked, legible over dark mist and bright dawn alike */
  .caption {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 16vh;
    margin: 0;
    padding: 0 8vw;
    text-align: center;
    z-index: 3;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.05;
    font-size: clamp(1.3rem, 4.4vw, 2.9rem);
    color: var(--color-wtp-paper, #f6f4ee);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.55), 0 1px 3px rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    will-change: opacity, transform;
  }

  /* Scroll hint — bottom-centre chevron, hidden after the first nudge */
  .scroll-hint {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 5vh;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    color: rgba(246, 244, 238, 0.75);
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  .scroll-hint .chev {
    font-size: 1.5rem;
    line-height: 1;
    animation: hint-bob 1.8s ease-in-out infinite;
  }
  .scroll-hint.gone {
    opacity: 0;
  }
  @keyframes hint-bob {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(5px); opacity: 1; }
  }

  /* Arrival CTA */
  .join {
    position: fixed;
    inset: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 14vh;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.9s ease, visibility 0.9s ease;
    pointer-events: none;
  }
  .join.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .join-tag {
    margin: 0 0 1.4rem;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: clamp(1.1rem, 3.4vw, 1.7rem);
    color: var(--color-wtp-paper, #f6f4ee);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
  }
  .join-cta {
    padding: 0.9rem 2.8rem;
    border-radius: 999px;
    background: var(--color-wtp-paper, #f6f4ee);
    color: var(--color-wtp-green, #004225);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s ease;
  }
  .join-cta:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint .chev {
      animation: none;
    }
  }
</style>
