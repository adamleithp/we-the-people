---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import { Image } from 'astro:assets';
import problemImg from '../assets/our-real-problem-jonny-gios-8iq0yqemBuU-unsplash.jpg';
import hopeImg from '../assets/our-real-hope-jonathan-harrison-G4UAlDJeJFk-unsplash.jpg';
import partImg from '../assets/be-part-of-it-priscilla-du-preez-3gAiajAfjXI-unsplash.jpg';

const SECTIONS = [
  {
    n: '01',
    title: 'Our Real Problem',
    blurb:
      'We all have opinions on what needs to be done. But there is a deeper threat which almost no-one is trying to fix.',
    cta: 'See the problem',
    href: '/problem',
    image: problemImg,
  },
  {
    n: '02',
    title: 'Our Real Hope',
    blurb:
      'Both ancient and new, a practical plan for how we overcome our divisions and start to turn things around.',
    cta: 'See the hope',
    href: '/hope',
    image: hopeImg,
  },
  {
    n: '03',
    title: 'Be Part of It',
    blurb:
      'Here are ways to help make it happen by yourself, in your community and for our country.',
    cta: 'Find your part',
    href: '/be-part-of-it',
    image: partImg,
  },
];
---

<Layout
  title="We The People — Reunite the Country, Transform the System"
  introLines={['We The', 'People']}
  introVariant="hero"
>
  <main>
    <!-- the intro's pane matches this one, so the assembled wordmark lands here -->
    <PageHero lines={['We The', 'People']} variant="hero">
      <HeroBackdrop slot="backdrop" />
      <!-- the tagline starts as the glass lifts -->
      <p class="hero__tagline fade-up">Reunite the Country · Transform the System</p>
    </PageHero>

    <section class="creed">
      <p class="creed__body">
        Britain is in crisis. We The People is a vision of how we can change our
        fortunes – and our future – together. The task is enormous. This is how it begins.
      </p>
    </section>

    <section class="panels" id="sections">
      {
        SECTIONS.map((s) => (
          <a class="panel" href={s.href}>
            <Image
              class="panel__img"
              src={s.image}
              alt=""
              width={960}
              widths={[480, 960]}
              sizes="(max-width: 640px) 100vw, 33vw"
              format="webp"
              quality={70}
            />
            <span class="panel__n">{s.n}</span>
            <h2 class="panel__title">{s.title}</h2>
            <p class="panel__blurb">{s.blurb}</p>
            <span class="panel__cta">
              {s.cta} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </section>

  </main>
</Layout>

<style>
  .hero__tagline {
    margin: 0;
    font-size: clamp(0.85rem, 2.2vw, 1.05rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(246, 244, 238, 0.62);
  }
  /* --- the manifesto ------------------------------------------------------- */
  .creed {
    max-width: 46ch; /* short measure — it should read like a letter, not a page */
    margin-inline: auto;
    padding: clamp(4rem, 12vh, 8rem) 1.5rem clamp(4rem, 12vh, 7rem);
    text-align: left;
  }
  .creed__body {
    margin: 0;
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.85;
    letter-spacing: 0.005em;
    text-wrap: pretty;
    color: rgba(246, 244, 238, 0.82);
  }
  .creed__body::first-line {
    color: #fff;
  }
  /* --- three flexed sections ---------------------------------------------- */
  .panels {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-wtp-bramble);
  }
  .panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    flex: 1 1 20rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 62vh;
    padding: clamp(2rem, 5vw, 3.4rem);
    text-decoration: none;
    color: inherit;
    border-right: 1px solid var(--color-wtp-bramble);
  }
  .panel:last-child {
    border-right: 0;
  }
  /* the photograph sits low under the type and comes up on hover */
  .panel__img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
    transition: opacity 0.45s var(--ease-out);
  }
  .panel:hover .panel__img,
  .panel:focus-visible .panel__img {
    opacity: 0.5;
  }
  .panel:focus-visible {
    outline: 2px solid var(--color-wtp-dawn);
    outline-offset: -4px;
  }
  .panel__n {
    font-family: var(--font-wordmark);
    font-size: 0.85rem;
    letter-spacing: 0.28em;
    color: var(--color-wtp-dawn);
  }
  .panel__title {
    margin: 0;
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 0.95;
    color: #fff;
  }
  .panel__blurb {
    margin: 0;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(246, 244, 238, 0.72);
  }
  .panel__cta {
    margin-top: auto;
    padding-top: 1.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-wtp-paper);
  }


  @media (max-width: 640px) {
    .panel {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--color-wtp-bramble);
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.panel').forEach(function (panel) {
      panel.addEventListener('click', function () {
        var title = panel.querySelector('.panel__title')?.textContent?.trim() || '';
        window.posthog?.capture('homepage_panel_clicked', { panel_title: title });
      });
    });
  });
</script>
