---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';

const SECTIONS = [
  {
    n: '01',
    title: 'The Idea',
    blurb:
      'Trust in politics is the lowest it has ever been. There is another way we have overlooked — a Citizens’ Assembly.',
    cta: 'Read the idea',
    href: '/idea',
  },
  {
    n: '02',
    title: 'In Practice',
    blurb:
      'A National Council of the People on immigration: ten days, every perspective heard, one policy written by us.',
    cta: 'See the plan',
    href: '/practice',
  },
  {
    n: '03',
    title: 'Join Us',
    blurb:
      'Movements are made of people. Add your name and be part of the first step.',
    cta: 'Sign up',
    href: '/join',
  },
];
---

<Layout
  title="We The People — Reunite the Country, Transform the System"
  introLines={['We The', 'People']}
  introVariant="hero"
>
  <main>
    <!-- the intro's pane matches this one, so the assembled wordmark lands here -->
    <PageHero lines={['We The', 'People']} variant="hero">
      <HeroBackdrop slot="backdrop" />
      <!-- the tagline starts as the glass lifts -->
      <p class="hero__tagline fade-up">Reunite the Country · Transform the System</p>
    </PageHero>

    <!-- The manifesto, in the movement's voice — unsigned. -->
    <section class="creed">
      <p class="creed__body">
        There is a quiet most of us would recognise — the sense of being spoken for, and
        rarely spoken to; the feeling that the argument itself has become the point. We do
        not believe this country is divided in its heart. It is divided by the room it has
        been given to speak in. So we are building a better room. One hundred of us, drawn
        as a jury is drawn, from every corner and every conviction; sat together long
        enough to hear the whole of a thing; trusted, at last, to write what comes next.
        Not left, not right — forward. This is not a protest against anyone. It is an
        invitation to everyone. Come as you are, bring your history, keep your beliefs. We
        ask one thing only: hold the country above the quarrel. We are many. We are one.
      </p>
    </section>

    <section class="panels" id="sections">
      {
        SECTIONS.map((s) => (
          <a class="panel" href={s.href}>
            <span class="panel__n">{s.n}</span>
            <h2 class="panel__title">{s.title}</h2>
            <p class="panel__blurb">{s.blurb}</p>
            <span class="panel__cta">
              {s.cta} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </section>

    <footer class="foot">
      <p class="foot__mark">Be part of hope</p>
      <a class="foot__link" href="/join">Join Us</a>
    </footer>
  </main>
</Layout>

<style>
  .hero__tagline {
    margin: 0;
    font-size: clamp(0.85rem, 2.2vw, 1.05rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(246, 244, 238, 0.62);
  }
  /* --- the manifesto ------------------------------------------------------- */
  .creed {
    max-width: 46ch; /* short measure — it should read like a letter, not a page */
    margin-inline: auto;
    padding: clamp(4rem, 12vh, 8rem) 1.5rem clamp(4rem, 12vh, 7rem);
    text-align: left;
  }
  .creed__body {
    margin: 0;
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.85;
    letter-spacing: 0.005em;
    text-wrap: pretty;
    color: rgba(246, 244, 238, 0.82);
  }
  .creed__body::first-line {
    color: #fff;
  }
  /* --- three flexed sections ---------------------------------------------- */
  .panels {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid rgba(246, 244, 238, 0.14);
  }
  .panel {
    flex: 1 1 20rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 62vh;
    padding: clamp(2rem, 5vw, 3.4rem);
    text-decoration: none;
    color: inherit;
    border-right: 1px solid rgba(246, 244, 238, 0.14);
    transition: background-color 0.35s ease;
  }
  .panel:last-child {
    border-right: 0;
  }
  .panel:hover,
  .panel:focus-visible {
    background-color: var(--color-wtp-green);
    outline: none;
  }
  .panel__n {
    font-family: var(--font-wordmark);
    font-size: 0.85rem;
    letter-spacing: 0.28em;
    color: var(--color-wtp-dawn);
  }
  .panel__title {
    margin: 0;
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 0.95;
    color: #fff;
  }
  .panel__blurb {
    margin: 0;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(246, 244, 238, 0.72);
  }
  .panel__cta {
    margin-top: auto;
    padding-top: 1.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-wtp-paper);
  }

  /* --- foot ---------------------------------------------------------------- */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 5vw, 3.4rem);
    border-top: 1px solid rgba(246, 244, 238, 0.14);
  }
  .foot__mark {
    margin: 0;
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.95rem;
    color: rgba(246, 244, 238, 0.6);
  }
  .foot__link {
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    color: var(--color-wtp-dawn);
  }

  @media (max-width: 640px) {
    .panel {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid rgba(246, 244, 238, 0.14);
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.panel').forEach(function (panel) {
      panel.addEventListener('click', function () {
        var title = panel.querySelector('.panel__title')?.textContent?.trim() || '';
        window.posthog?.capture('homepage_panel_clicked', { panel_title: title });
      });
    });
  });
</script>
