---
// The words on this page live in src/content/home.yml — that file is what the
// CMS at /admin edits.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import { home } from '../lib/content';
import { inline } from '../lib/inline';
---

<Layout title={home.page_title} introLines={home.title_lines} introVariant="hero">
  <main>
    <!-- the intro's pane matches this one, so the assembled wordmark lands here -->
    <PageHero lines={home.title_lines} variant="hero">
      <HeroBackdrop slot="backdrop" />
      <!-- the tagline starts as the glass lifts -->
      <p class="hero__tagline fade-up">{home.tagline}</p>
    </PageHero>

    <section class="creed">
      <p class="creed__body" set:html={inline(home.creed)} />
    </section>

    <section class="panels" id="sections">
      {
        home.panels.map((panel) => (
          <a class="panel" href={panel.href}>
            <span class="panel__n">{panel.number}</span>
            <h2 class="panel__title">{panel.title}</h2>
            <p class="panel__blurb">{panel.blurb}</p>
            <span class="panel__cta">
              {panel.cta} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </section>

    <footer class="foot">
      <p class="foot__mark">{home.footer.mark}</p>
      <a class="foot__link" href={home.footer.link_href}>
        {home.footer.link_label}
      </a>
    </footer>
  </main>
</Layout>

<style>
  .hero__tagline {
    margin: 0;
    font-size: clamp(0.85rem, 2.2vw, 1.05rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(246, 244, 238, 0.62);
  }
  /* --- the manifesto ------------------------------------------------------- */
  .creed {
    max-width: 46ch; /* short measure — it should read like a letter, not a page */
    margin-inline: auto;
    padding: clamp(4rem, 12vh, 8rem) 1.5rem clamp(4rem, 12vh, 7rem);
    text-align: left;
  }
  .creed__body {
    margin: 0;
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.85;
    letter-spacing: 0.005em;
    text-wrap: pretty;
    color: rgba(246, 244, 238, 0.82);
  }
  .creed__body::first-line {
    color: #fff;
  }
  /* --- three flexed sections ---------------------------------------------- */
  .panels {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid rgba(246, 244, 238, 0.14);
  }
  .panel {
    flex: 1 1 20rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 62vh;
    padding: clamp(2rem, 5vw, 3.4rem);
    text-decoration: none;
    color: inherit;
    border-right: 1px solid rgba(246, 244, 238, 0.14);
    transition: background-color 0.35s ease;
  }
  .panel:last-child {
    border-right: 0;
  }
  .panel:hover,
  .panel:focus-visible {
    background-color: var(--color-wtp-green);
    outline: none;
  }
  .panel__n {
    font-family: var(--font-wordmark);
    font-size: 0.85rem;
    letter-spacing: 0.28em;
    color: var(--color-wtp-dawn);
  }
  .panel__title {
    margin: 0;
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 0.95;
    color: #fff;
  }
  .panel__blurb {
    margin: 0;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(246, 244, 238, 0.72);
  }
  .panel__cta {
    margin-top: auto;
    padding-top: 1.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-wtp-paper);
  }

  /* --- foot ---------------------------------------------------------------- */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 5vw, 3.4rem);
    border-top: 1px solid rgba(246, 244, 238, 0.14);
  }
  .foot__mark {
    margin: 0;
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.95rem;
    color: rgba(246, 244, 238, 0.6);
  }
  .foot__link {
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    color: var(--color-wtp-dawn);
  }

  @media (max-width: 640px) {
    .panel {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid rgba(246, 244, 238, 0.14);
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.panel').forEach(function (panel) {
      panel.addEventListener('click', function () {
        var title = panel.querySelector('.panel__title')?.textContent?.trim() || '';
        window.posthog?.capture('homepage_panel_clicked', { panel_title: title });
      });
    });
  });
</script>
