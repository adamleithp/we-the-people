---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import CreedIntro from '../components/CreedIntro.astro';
import GlassIntro from '../components/GlassIntro.astro';

const SECTIONS = [
  {
    n: '01',
    title: 'The Idea',
    blurb:
      'Our system is breaking. The politicians are a big part of the problem. But there is another way.',
    cta: 'Read the idea',
    href: '/idea',
  },
  {
    n: '02',
    title: 'In Practice',
    blurb: 'From national to local level, this is how we start to turn things around.',
    cta: 'See the plan',
    href: '/practice',
  },
  {
    n: '03',
    title: 'Join Us',
    blurb:
      'If you believe in unity. If you want to see peace. Help make it happen — and be part of hope.',
    cta: 'Sign up',
    href: '/join',
  },
];
---

<Layout
  title="We The People — Reunite the Country, Transform the System"
  intro={false}
>
  <main>
    <!-- the homepage opens on the creed, word by word, with the page held -->
    <CreedIntro
      text="Britain in 2026 is in a tough place. We The People is a vision of how we can change our fortunes and our future together. The task is enormous. This is how it begins."
    />

    <!-- scrolling down, the wordmark assembles in glass in its own pane -->
    <PageHero id="hero" lines={['We The', 'People']} variant="hero">
      <HeroBackdrop slot="backdrop" />
      <!-- carries the creed's warmth over the top of the photograph: no seam -->
      <div slot="backdrop" class="hero__seam" aria-hidden="true"></div>
      <GlassIntro slot="glass" lines={['We The', 'People']} variant="hero" trigger="scroll" />
      <!-- the tagline follows the glass in -->
      <p class="hero__tagline">Reunite the Country · Transform the System</p>
    </PageHero>

    <section class="panels" id="sections">
      {
        SECTIONS.map((s) => (
          <a class="panel" href={s.href}>
            <span class="panel__n">{s.n}</span>
            <h2 class="panel__title">{s.title}</h2>
            <p class="panel__blurb">{s.blurb}</p>
            <span class="panel__cta">
              {s.cta} <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </section>

    <footer class="foot">
      <p class="foot__mark">Be part of hope</p>
      <a class="foot__link" href="/join">Join Us</a>
    </footer>
  </main>
</Layout>

<style>
  .hero__tagline {
    margin: 0;
    font-size: clamp(0.85rem, 2.2vw, 1.05rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(246, 244, 238, 0.62);
  }
  /* The creed ends on black with its glow rising from the bottom edge. This is
     that same glow mirrored (same stops as .creed__warmth in CreedIntro, centre
     8svh above this edge instead of below that one), on the same black, fading
     out into the photograph — so scrolling down crosses no line. */
  .hero__seam {
    position: absolute;
    inset: 0 0 auto;
    height: 45%;
    z-index: 0;
    background:
      radial-gradient(
        120vw 70svh at 50% -8svh,
        rgba(251, 184, 109, 0.3) 0%,
        rgba(187, 103, 47, 0.2) 30%,
        rgba(87, 48, 27, 0.1) 55%,
        transparent 78%
      ),
      #000;
    mask-image: linear-gradient(to bottom, #000, transparent);
    pointer-events: none;
  }
  /* --- three flexed sections ---------------------------------------------- */
  .panels {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid rgba(246, 244, 238, 0.14);
  }
  .panel {
    flex: 1 1 20rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 62vh;
    padding: clamp(2rem, 5vw, 3.4rem);
    text-decoration: none;
    color: inherit;
    border-right: 1px solid rgba(246, 244, 238, 0.14);
    transition: background-color 0.35s ease;
  }
  .panel:last-child {
    border-right: 0;
  }
  .panel:hover,
  .panel:focus-visible {
    background-color: var(--color-wtp-green);
    outline: none;
  }
  .panel__n {
    font-family: var(--font-wordmark);
    font-size: 0.85rem;
    letter-spacing: 0.28em;
    color: var(--color-wtp-dawn);
  }
  .panel__title {
    margin: 0;
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    font-size: clamp(2rem, 5vw, 3.1rem);
    line-height: 0.95;
    color: #fff;
  }
  .panel__blurb {
    margin: 0;
    max-width: 34ch;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(246, 244, 238, 0.72);
  }
  .panel__cta {
    margin-top: auto;
    padding-top: 1.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-wtp-paper);
  }

  /* --- foot ---------------------------------------------------------------- */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 5vw, 3.4rem);
    border-top: 1px solid rgba(246, 244, 238, 0.14);
  }
  .foot__mark {
    margin: 0;
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.95rem;
    color: rgba(246, 244, 238, 0.6);
  }
  .foot__link {
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    color: var(--color-wtp-dawn);
  }

  @media (max-width: 640px) {
    .panel {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid rgba(246, 244, 238, 0.14);
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.panel').forEach(function (panel) {
      panel.addEventListener('click', function () {
        var title = panel.querySelector('.panel__title')?.textContent?.trim() || '';
        window.posthog?.capture('homepage_panel_clicked', { panel_title: title });
      });
    });
  });
</script>
