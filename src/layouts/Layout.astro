---
import { Font } from 'astro:assets';
import '../styles/base.css';
import Header from '../components/Header.astro';
import GlassIntro from '../components/GlassIntro.astro';
import PostHog from '../components/posthog.astro';

interface Props {
  title?: string;
  /** the page's own title for the glass intro, one entry per line */
  introLines?: string[];
  introVariant?: 'hero' | 'page';
}

const {
  title = 'We The People',
  introLines = ['We The', 'People'],
  introVariant = 'page',
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="We The People — Reunite the Country, Transform the System." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Self-hosted, subset & preloaded by the Astro Fonts API -->
    <Font cssVariable="--font-anton" preload />
    <title>{title}</title>
    <PostHog />
  </head>
  <body>
    <!-- every page opens with its own title in glass; the header is global -->
    <GlassIntro lines={introLines} variant={introVariant} />
    <Header />
    <slot />
  </body>
</html>
