---
import { Font } from 'astro:assets';
import '../styles/base.css';
import Header from '../components/Header.astro';
import GlassIntro from '../components/GlassIntro.astro';
import PostHog from '../components/posthog.astro';
import JoinFooter from '../components/JoinFooter.astro';

interface Props {
  title?: string;
  /** the page's own title for the glass intro, one entry per line */
  introLines?: string[];
  introVariant?: 'hero' | 'page';
  /** false: no load-time glass overlay (the homepage builds its title on scroll) */
  intro?: boolean;
  /** keep I'm In folded away until the pill opens it */
  joinCollapsed?: boolean;
}

const {
  title = 'We The People',
  introLines = ['We The', 'People'],
  introVariant = 'page',
  intro = true,
  joinCollapsed = false,
} = Astro.props;
---

<!doctype html>
<!-- without the overlay nothing clears the page to arrive, so it starts cleared -->
<html lang="en-GB" class={intro ? undefined : 'intro-done'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="We The People — Reunite the Country, Transform the System." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Self-hosted, subset & preloaded by the Astro Fonts API -->
    <Font cssVariable="--font-anton" preload />
    <title>{title}</title>
    <PostHog />
  </head>
  <body>
    <!-- every page opens with its own title in glass; the header and the
         I'm In sign-up are global -->
    {intro && <GlassIntro lines={introLines} variant={introVariant} />}
    <Header />
    <slot />
    <JoinFooter collapsed={joinCollapsed} />
  </body>
</html>
