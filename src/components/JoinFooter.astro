---
interface Props {
  /** folded away until the pill (or a #im-in link) opens it */
  collapsed?: boolean;
}
const { collapsed = false } = Astro.props;
---

<!-- I'M IN: the sign-up, at the foot of every page. The pill stays in reach
     while you read and steps aside once the form itself is on screen. Where
     `collapsed`, the form stays hidden until the pill asks for it, so people
     learn what the project is before being asked to sign up. -->
<!-- .fade-up's animation holds opacity, so the pill's own hide/show sits one level in -->
<div class="im-in-dock fade-up" style="--fade-delay:0.36s">
  <a
    class="im-in-pill"
    href="#im-in"
    data-im-in-pill
    aria-controls={collapsed ? 'im-in' : undefined}
    aria-expanded={collapsed ? 'false' : undefined}>I'm In</a
  >
</div>

<footer
  class="join"
  id="im-in"
  aria-labelledby="im-in-title"
  data-collapsible={collapsed ? '' : undefined}
  hidden={collapsed}
>
  <div class="join__copy">
  <h2 class="join__title" id="im-in-title" tabindex="-1">I'm In</h2>
  <p class="lede">
    The challenges ahead may be significant, but nothing is impossible if
    <strong>We The People</strong> work together.
  </p>
  <p class="lede">
    Sign up <span class="where where--below">below</span><span class="where where--side">here</span>
    or email <a href="mailto:hello@wethepeoplegather.com">hello@wethepeoplegather.com</a>.
  </p>
  <ol class="steps">
    <li>
      <span class="steps__title">Register</span>
      Tell us who you are and where you are based.
    </li>
    <li>
      <span class="steps__title">Stay informed</span>
      Receive important updates directly by email.
    </li>
    <li>
      <span class="steps__title">Get involved</span>
      Be ready for conversations, events and opportunities to take action.
    </li>
  </ol>
  </div>
  <!-- TODO: also wire to a real list provider (Mailchimp / Action Network / …).
       Right now the only record of a sign-up is the PostHog person profile. -->
  <form class="signup" data-signup novalidate>
    <div class="field">
      <label for="name">Name</label>
      <input id="name" type="text" name="name" autocomplete="name" spellcheck="false" required />
    </div>

    <div class="field">
      <label for="email">Email address</label>
      <input id="email" type="email" name="email" autocomplete="email" required />
    </div>

    <div class="field">
      <label for="town">Village, town or city</label>
      <input
        id="town"
        type="text"
        name="town"
        autocomplete="address-level2"
        spellcheck="false"
        required
      />
    </div>

    <div class="field">
      <label for="county">County</label>
      <input
        id="county"
        type="text"
        name="county"
        autocomplete="address-level1"
        spellcheck="false"
        required
      />
    </div>

    <label class="consent">
      <input type="checkbox" name="consent" required />
      <span>
        Yes — register me with <strong>We The People</strong>. I confirm that I consent to receiving
        occasional updates and news about meetings, events and ways to get involved by email.
        I understand that I can unsubscribe at any time. Read our
        <a href="/privacy">privacy policy</a>.
      </span>
    </label>

    <button type="submit">I'm In</button>
  </form>
</footer>

<!-- Shown once the sign-up event has been captured. Esc or the ✕ closes it. -->
<div class="thanks" data-thanks hidden>
  <div class="thanks__backdrop" data-thanks-dismiss></div>
  <div class="thanks__panel" role="dialog" aria-modal="true" aria-labelledby="thanks-text">
    <p class="thanks__text" id="thanks-text">
      Thank you for joining us, we'll send over more information as soon as possible.
    </p>
    <button class="thanks__close" type="button" data-thanks-dismiss aria-label="Close">
      <span aria-hidden="true">✕</span>
    </button>
  </div>
</div>

<style>

  /* "in signing on the right" beside the form, "below" once it stacks under the words */
  .where--side {
    display: none;
  }
  @media (min-width: 900px) {
    .where--side {
      display: inline;
    }
    .where--below {
      display: none;
    }
  }
  /* copy left, form right; stacked on narrow screens. Sits on the page ground,
     set off by a hairline, with the form on a raised green card. */
  .join {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: clamp(2.5rem, 6vw, 5rem);
    max-width: 76rem;
    margin-inline: auto;
    padding: clamp(4rem, 12vh, 7rem) clamp(1.5rem, 5vw, 3.4rem) clamp(6rem, 16vh, 9rem);
    border-top: 1px solid var(--color-wtp-bramble);
    scroll-margin-top: 3rem;
  }
  @media (min-width: 900px) {
    .join {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
  .join__copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .join__title {
    margin: 0 0 0.8rem;
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    font-size: var(--type-display-xl);
    line-height: 0.9;
    color: #fff;
  }
  .lede {
    margin: 0;
    max-width: 36rem;
    font-size: var(--type-lg);
    line-height: 1.55;
    opacity: 0.9;
  }
  .lede strong {
    color: #fff;
  }
  .steps {
    display: grid;
    gap: 1.2rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    max-width: 36rem;
    padding-left: 2.6rem;
    font-size: var(--type-base);
    line-height: 1.5;
    opacity: 0.9;
    counter-increment: step;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.05em;
    font-family: var(--font-wordmark);
    font-size: var(--type-display-md);
    line-height: 1;
    color: var(--color-wtp-dawn);
  }
  .steps__title {
    display: block;
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--type-display-sm);
    color: #fff;
  }
  /* a collapsed footer opening on the pill's click */
  .join.is-opening {
    animation: join-open 0.5s var(--ease-out) both;
  }
  @keyframes join-open {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .join.is-opening {
      animation: none;
    }
  }
  /* the form card is a neutral near-black, not green, so the fields read as
     a tool on the page rather than another panel of it */
  .signup {
    --card: #151716;
    --field: #0b0c0c;
    --line: rgba(255, 255, 255, 0.1);
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.5rem, 4vw, 2.4rem);
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--card);
  }
  @media (min-width: 900px) {
    .signup {
      position: sticky;
      top: 6rem;
    }
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-size: var(--type-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(246, 244, 238, 0.6);
  }
  .signup input {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: var(--field);
    color: var(--color-wtp-paper, #f6f4ee);
    font-family: inherit;
    font-size: var(--type-base);
    transition: border-color 150ms ease;
  }
  .signup input:focus-visible {
    outline: none;
    border-color: var(--color-wtp-dawn);
  }
  .signup input:user-invalid {
    border-color: #e0736d;
  }
  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
    font-size: var(--type-sm);
    line-height: 1.5;
    color: rgba(246, 244, 238, 0.75);
    cursor: pointer;
  }
  .signup .consent input {
    width: 1.15rem;
    height: 1.15rem;
    margin: 0.15rem 0 0;
    padding: 0;
    accent-color: var(--color-wtp-dawn);
  }
  /* the field rule above recolours a border a checkbox doesn't draw */
  .signup .consent input:focus-visible {
    outline: 2px solid var(--color-wtp-dawn);
    outline-offset: 2px;
  }
  .join__title:focus {
    outline: none;
  }
  .signup button {
    justify-self: start;
    padding: 0.85rem 2.4rem;
    border: 0;
    border-radius: 999px;
    /* the green the hero sets up (26 Oct doc: buttons match it) */
    background: var(--color-wtp-green-500);
    color: var(--color-wtp-paper);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: var(--type-base);
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }
  .signup button:active {
    transform: scale(0.97);
  }

  /* --- thank-you overlay ---------------------------------------------------- */
  .thanks {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    padding: 6vw;
  }
  .thanks[hidden] {
    display: none;
  }
  .thanks__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 12, 7, 0.8);
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }
  .thanks__panel {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.8rem;
    max-width: 30rem;
    padding: clamp(2rem, 6vw, 3rem);
    background: var(--color-wtp-green);
    text-align: center;
    /* never from scale(0) — it should arrive, not appear from nothing */
    opacity: 0;
    transform: scale(0.96) translateY(6px);
    /* paired with the backdrop: same duration, same curve */
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  .thanks.is-open .thanks__backdrop {
    opacity: 1;
  }
  .thanks.is-open .thanks__panel {
    opacity: 1;
    transform: none;
  }
  /* exit is quicker than entry — the system responding, not the user deciding */
  .thanks.is-closing .thanks__backdrop,
  .thanks.is-closing .thanks__panel {
    transition-duration: 150ms;
  }
  .thanks__text {
    margin: 0;
    font-size: var(--type-lg);
    line-height: 1.5;
    color: #fff;
  }
  .thanks__close {
    display: grid;
    place-items: center;
    width: 2.75rem; /* 44px hit area */
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      transform 160ms var(--ease-out);
  }
  .thanks__close:active {
    transform: scale(0.94);
  }
  .thanks__close:focus-visible {
    outline: 2px solid var(--color-wtp-dawn);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .thanks__close:hover {
      background-color: rgba(255, 255, 255, 0.14);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .thanks__backdrop,
    .thanks__panel,
    .thanks__close,
    .signup button {
      transition: none;
    }
    .thanks__panel {
      transform: none;
    }
  }

  /* --- the pill ----------------------------------------------------------- */
  .im-in-dock {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 40;
  }
  .im-in-pill {
    display: block;
    padding: 0.85rem 1.7rem;
    border-radius: 999px;
    background: var(--color-wtp-green-500);
    color: var(--color-wtp-paper);
    font-family: var(--font-wordmark);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--type-sm);
    text-decoration: none;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }
  .im-in-pill:active {
    transform: scale(0.97);
  }
  .im-in-pill:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  /* the form is on screen — the pill has nothing left to point at */
  .im-in-pill.is-away {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .im-in-pill {
      transition: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var footer = document.getElementById('im-in');
    var pill = document.querySelector('[data-im-in-pill]');
    var viewed = false;
    if (footer) {
      new IntersectionObserver(function (entries) {
        var visible = entries[0].isIntersecting;
        if (pill) pill.classList.toggle('is-away', visible);
        if (visible && !viewed) {
          viewed = true;
          window.posthog?.capture('join_footer_viewed');
        }
      }, { threshold: 0.15 }).observe(footer);
    }
    // a collapsed footer opens on the pill, or on arriving at #im-in
    function openJoin() {
      if (!footer || !footer.hidden) return;
      footer.hidden = false;
      footer.classList.add('is-opening');
      // html glides anchor jumps; this one is the system answering a press, so it's instant
      footer.scrollIntoView({ block: 'start', behavior: 'instant' });
      if (pill) pill.setAttribute('aria-expanded', 'true');
      // a keyboard lands straight in the form; on touch, focusing a field would
      // throw the on-screen keyboard up before they've read a word
      var target = matchMedia('(pointer: fine)').matches
        ? document.getElementById('name')
        : document.getElementById('im-in-title');
      if (target) target.focus({ preventScroll: true });
    }
    if (footer && footer.hidden && location.hash === '#im-in') openJoin();

    if (pill) {
      pill.addEventListener('click', function (e) {
        window.posthog?.capture('im_in_pill_clicked', { path: location.pathname });
        if (footer && footer.hidden) {
          e.preventDefault();
          openJoin();
          history.replaceState(null, '', '#im-in');
        }
      });
    }

    var form = document.querySelector('[data-signup]');
    var emailInput = document.getElementById('email');
    var thanks = document.querySelector('[data-thanks]');
    var closeBtn = thanks && thanks.querySelector('.thanks__close');

    if (emailInput) {
      emailInput.addEventListener('blur', function () {
        if (emailInput.value) {
          window.posthog?.capture('join_signup_attempted');
        }
      });
    }

    // --- thank-you overlay ---------------------------------------------------
    var lastFocused = null;

    function openThanks() {
      if (!thanks) return;
      lastFocused = document.activeElement;
      thanks.hidden = false;
      document.body.style.overflow = 'hidden';
      // next frame, so the transition runs from the closed state
      requestAnimationFrame(function () {
        thanks.classList.add('is-open');
      });
      if (closeBtn) closeBtn.focus();
    }

    function closeThanks() {
      if (!thanks || thanks.hidden) return;
      thanks.classList.remove('is-open');
      thanks.classList.add('is-closing');
      window.setTimeout(function () {
        thanks.hidden = true;
        thanks.classList.remove('is-closing');
        document.body.style.overflow = '';
        if (lastFocused && lastFocused.focus) lastFocused.focus();
      }, 160);
    }

    if (thanks) {
      thanks.querySelectorAll('[data-thanks-dismiss]').forEach(function (el) {
        el.addEventListener('click', closeThanks);
      });
    }

    document.addEventListener('keydown', function (e) {
      if (!thanks || thanks.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeThanks();
      }
      // the close button is the only focusable thing in here — keep focus in
      if (e.key === 'Tab') {
        e.preventDefault();
        if (closeBtn) closeBtn.focus();
      }
    });

    // --- sign-up -------------------------------------------------------------
    if (form && emailInput) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        var data = new FormData(form);
        var email = String(data.get('email') || '').trim();
        var name = String(data.get('name') || '').trim();
        var town = String(data.get('town') || '').trim();
        var county = String(data.get('county') || '').trim();

        // PII (email, name, where they live) goes on the person profile —
        // PostHog's rule is PII belongs in identify(), never in capture() properties.
        // The consent timestamp is the GDPR record of the opt-in.
        window.posthog?.identify(email, {
          email: email,
          name: name,
          town: town,
          county: county,
          email_consent: true,
          email_consent_at: new Date().toISOString(),
        });
        // The event records that a sign-up happened, with only the
        // non-identifying bits as properties so it stays safe to break down on.
        window.posthog?.capture('join_us_submitted', { county: county });

        form.reset();
        openThanks();
      });
    }
  });
</script>
