---
/**
 * The hero's photograph — the British land, behind the wordmark. A scrim sits
 * over it so the white wordmark keeps its contrast.
 *
 * The other candidates live in `src/assets/hero/`; <ShatterTitle> uses them as
 * its portrait fallback until `src/assets/faces/` has images.
 *
 * The originals are 4–40 megapixel Unsplash JPEGs. They go through `getImage()`
 * rather than `public/`, so what ships is a ~2400px WebP instead of a 1 MB JPEG
 * the browser has to decode at full size before it can paint the hero.
 */
import { getImage } from 'astro:assets';
import source from '../assets/hero/evgeniy-prokofiev-mLQIoxX9yAo-unsplash.jpg';

const image = await getImage({ src: source, width: 2400, format: 'webp', quality: 72 });
---

<div class="backdrop" aria-hidden="true">
  <img class="backdrop__img" src={image.src} alt="" fetchpriority="high" decoding="async" />
  <div class="backdrop__scrim"></div>
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .backdrop__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* the photo is atmosphere, not the subject */
    opacity: 0.8;
  }
  /* darkens top and bottom so the header and the wordmark stay legible */
  .backdrop__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(11, 11, 11, 0.45),
        rgba(11, 11, 11, 0.1) 38%,
        rgba(11, 11, 11, 0.35) 78%,
        var(--color-wtp-night, #0b0b0b)
      ),
      radial-gradient(120% 80% at 50% 45%, transparent 30%, rgba(11, 11, 11, 0.3));
  }
</style>
