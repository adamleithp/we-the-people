---
/**
 * The hero's photograph — dawn over the British land, behind the wordmark. A
 * scrim sits over it so the white wordmark keeps its contrast.
 *
 * The other candidates live in `src/assets/hero/`; <ShatterTitle> uses them as
 * its portrait fallback until `src/assets/faces/` has images.
 *
 * The source is 2560px wide — the largest size this ever paints — and goes
 * through `<Picture>` rather than `public/`, so a phone downloads a ~9 kB
 * 640px plate instead of the desktop one. The masters stay out of `public/`
 * for the same reason: it ships files untouched.
 *
 * WebP only, deliberately. AVIF was measured on this photo and lost at every
 * width — 137 kB against WebP's 62 kB at 2560, and it loses at 640 too. One
 * `quality` number doesn't mean the same thing to both encoders, and listing
 * AVIF first hands most browsers the heavier file.
 */
import { Picture } from 'astro:assets';
import source from '../assets/hero/istock-1246131595-dawn-mist.jpg';
---

<div class="backdrop" aria-hidden="true">
  <Picture
    class="backdrop__img"
    src={source}
    alt=""
    widths={[640, 1280, 1920, 2560]}
    sizes="100vw"
    formats={['webp']}
    quality={72}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="backdrop__scrim"></div>
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .backdrop__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* the sun sits just above the midline — bias the crop so it survives on
       tall phone viewports, where a centred crop cuts it out of frame */
    object-position: center 40%;
    /* the photo is atmosphere, not the subject */
    opacity: 0.8;
  }
  /* darkens top and bottom so the header and the wordmark stay legible */
  .backdrop__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(11, 11, 11, 0.45),
        rgba(11, 11, 11, 0.1) 38%,
        rgba(11, 11, 11, 0.35) 78%,
        var(--color-wtp-night, #0b0b0b)
      ),
      radial-gradient(120% 80% at 50% 45%, transparent 30%, rgba(11, 11, 11, 0.3));
  }
</style>
