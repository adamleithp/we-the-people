---
/**
 * The hero's photograph — the British land, behind the wordmark. A scrim sits
 * over it so the white wordmark keeps its contrast.
 *
 * The other candidates still live in `public/hero/`; <ShatterTitle> uses them as
 * its portrait fallback until `public/faces/` has images.
 */
const image = '/hero/evgeniy-prokofiev-mLQIoxX9yAo-unsplash.jpg';
---

<div class="backdrop" aria-hidden="true">
  <img class="backdrop__img" src={image} alt="" fetchpriority="high" decoding="async" />
  <div class="backdrop__scrim"></div>
</div>

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .backdrop__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* the photo is atmosphere, not the subject */
    opacity: 0.55;
  }
  /* darkens top and bottom so the header and the wordmark stay legible */
  .backdrop__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(11, 11, 11, 0.75),
        rgba(11, 11, 11, 0.25) 38%,
        rgba(11, 11, 11, 0.6) 78%,
        var(--color-wtp-night, #0b0b0b)
      ),
      radial-gradient(120% 80% at 50% 45%, transparent 30%, rgba(11, 11, 11, 0.55));
  }
</style>
