---
interface Props {
  eyebrow?: string;
  heading: string;
  /** which side the pinned copy sits on */
  align?: 'left' | 'center' | 'right';
  /** wrapper height = how long the copy stays pinned (e.g. '210vh') */
  pin?: string;
}
const { eyebrow, heading, align = 'left', pin = '210vh' } = Astro.props;
---

<div class="story" style={`height:${pin};`}>
  <div class={`story__panel story__panel--${align}`}>
    <div class="story__content">
      <span class="story__bar" aria-hidden="true"></span>
      {eyebrow && <p class="story__eyebrow">{eyebrow}</p>}
      <h2 class="story__heading">{heading}</h2>
      <p class="story__body"><slot /></p>
    </div>
  </div>
</div>

<style>
  .story {
    position: relative;
    z-index: 10; /* copy always reads above the glass */
  }
  .story__panel {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    align-items: center;
    padding-inline: clamp(1.5rem, 7vw, 7rem);
  }
  .story__panel--left {
    justify-items: start;
    text-align: left;
  }
  .story__panel--center {
    justify-items: center;
    text-align: center;
  }
  .story__panel--right {
    justify-items: end;
    text-align: right;
  }

  .story__content {
    max-width: 30rem;
  }
  .story__bar {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-bottom: 1.3rem;
    background: var(--color-wtp-dawn, #f2c14e);
  }
  .story__panel--center .story__bar {
    margin-inline: auto;
  }
  .story__panel--right .story__bar {
    margin-left: auto;
  }
  .story__eyebrow {
    margin: 0 0 0.8rem;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    font-size: 0.78rem;
    color: var(--color-wtp-dawn, #f2c14e);
  }
  .story__heading {
    margin: 0 0 1.1rem;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    line-height: 0.96;
    letter-spacing: 0.01em;
    font-size: clamp(2.1rem, 6vw, 3.6rem);
    color: var(--color-wtp-paper, #f6f4ee);
  }
  .story__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 2.4vw, 1.18rem);
    line-height: 1.65;
    color: rgba(246, 244, 238, 0.78);
  }
</style>
