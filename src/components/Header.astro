---
// Fixed, transparent header overlaid on the hero: wordmark left, "Take action" right.
---

<header class="site-header">
  <a class="wordmark" href="/">We the People</a>
  <nav>
    <a class="action" href="/join">Take action</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.35rem clamp(1.2rem, 4vw, 2.6rem);
    pointer-events: none; /* let the hero receive events; links re-enable below */
  }
  .site-header a {
    pointer-events: auto;
    text-decoration: none;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    color: var(--color-wtp-paper, #f6f4ee);
  }
  .wordmark {
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    letter-spacing: 0.06em;
    line-height: 1;
  }
  .action {
    font-size: clamp(0.78rem, 1.6vw, 0.98rem);
    letter-spacing: 0.14em;
    padding: 0.4rem 0.15rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }
  .action:hover,
  .action:focus-visible {
    border-color: var(--color-wtp-dawn, #f2c14e);
  }
  .site-header a:focus-visible {
    outline: 2px solid var(--color-wtp-dawn, #f2c14e);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
