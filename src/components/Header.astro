---
// Fixed, transparent header: small wordmark left, the three parts and
// Foundations right; on phones Foundations sits just under the three (ADA-68).
// Eases in behind the glass intro (`.fade-up` waits on html.intro-done).
// Be Part of It opens a menu of its three levels on hover or keyboard focus;
// on touch it is a plain link, since the page opens on the same three panels.
// The current page's link keeps its underline (aria-current="page").
const LEVELS = [
  { id: 'you', label: 'You' },
  { id: 'community', label: 'Your Community' },
  { id: 'country', label: 'Our Country' },
];
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const current = (href: string) => (here === href ? 'page' : undefined);
---

<header class="site-header fade-up" style="--fade-delay:0.24s">
  <a class="wordmark" href="/">We the People</a>
  <nav aria-label="Main">
    <div class="nav__row">
      <a class="action" href="/problem" aria-current={current('/problem')}
        ><span class="action__our">The </span>Problem</a
      >
      <a class="action" href="/hope" aria-current={current('/hope')}
        ><span class="action__our">Our </span>Hope</a
      >
      <div class="menu">
        <a class="action" href="/be-part-of-it" aria-current={current('/be-part-of-it')}
          >Be Part of It<svg
            class="menu__caret"
            viewBox="0 0 10 6"
            width="10"
            height="6"
            aria-hidden="true"><path d="M1 1l4 4 4-4" /></svg
          ></a
        >
        <ul class="menu__list" aria-label="Be Part of It">
          {
            LEVELS.map((l) => (
              <li>
                <a class="menu__item" href={`/be-part-of-it#${l.id}`}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <a
      class="action action--under"
      href="/foundations"
      aria-current={current('/foundations')}>Foundations</a
    >
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.35rem clamp(1.2rem, 4vw, 2.6rem);
    pointer-events: none; /* let the hero receive events; links re-enable below */
    /* night, frosted: page titles and photographs pass underneath without the
       nav sitting on top of them. Static, so the blur costs nothing per frame. */
    background: rgba(5, 12, 7, 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .site-header a {
    pointer-events: auto;
    text-decoration: none;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    color: var(--color-wtp-paper, #f6f4ee);
    -webkit-tap-highlight-color: transparent;
  }
  .wordmark {
    font-size: var(--type-display-sm);
    letter-spacing: 0.06em;
    line-height: 1;
  }
  /* one row wherever the four fit. On phones there's no room beside the
     wordmark, so Foundations tucks in close under the three parts (ADA-68) */
  nav,
  .nav__row {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 2rem);
  }
  @media (max-width: 640px) {
    nav {
      flex-direction: column;
      gap: 0;
    }
    /* overlaps the row above's tap padding, so it reads as part of the nav */
    .site-header .action--under {
      margin-top: -0.7rem;
      padding-top: 0.3rem;
    }
  }

  /* --- links ------------------------------------------------------------ */
  .action {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-size: var(--type-xs);
    letter-spacing: 0.14em;
    white-space: pre; /* keeps "The " as one word with "Problem" */
    padding: 0.4rem 0.15rem;
    transition: transform 120ms var(--ease-out, ease-out);
  }
  /* the underline draws out from the middle: transform only, so it stays on
     the compositor. The current page keeps it. */
  .action::after {
    content: '';
    position: absolute;
    inset: auto 0.15rem 0;
    height: 2px;
    background: var(--color-wtp-dawn, #f2c14e);
    transform: scaleX(0);
    opacity: 0;
    transition:
      transform 180ms var(--ease-out, ease-out),
      opacity 180ms var(--ease-out, ease-out);
  }
  .action[aria-current='page']::after,
  .action:focus-visible::after {
    transform: none;
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .action:hover::after {
      transform: none;
      opacity: 1;
    }
  }
  /* the press is felt: a touch smaller while held */
  .action:active {
    transform: scale(0.97);
  }
  /* fingers need 44px; the type stays small, the hit area grows */
  @media (pointer: coarse) {
    .action {
      padding-block: 0.9rem;
    }
    .action::after {
      bottom: 0.55rem;
    }
  }
  /* phones: "Problem · Hope · Be Part of It" fits beside the wordmark, "The/Our …" doesn't */
  @media (max-width: 560px) {
    .action__our {
      display: none;
    }
  }

  /* --- Be Part of It's menu --------------------------------------------- */
  .menu {
    position: relative;
    display: flex;
  }
  /* a caret says there's more here; it turns over while the menu is open.
     Touch has no menu, so no caret. */
  .menu__caret {
    display: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    margin-left: 0.45em;
    opacity: 0.7;
    transition: transform 180ms var(--ease-out, ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .menu__caret {
      display: block;
    }
    .menu:hover .menu__caret {
      transform: rotate(180deg);
    }
  }
  .menu:focus-within .menu__caret {
    transform: rotate(180deg);
  }
  /* Grows from its corner under the trigger, quickly; closes faster still,
     after a short grace so a pointer that slips on the way down doesn't lose
     it. The top padding bridges the gap under the link. */
  .menu__list {
    position: absolute;
    top: 100%;
    right: -1rem;
    margin: 0;
    padding: 0.9rem 0 0;
    list-style: none;
    transform-origin: top right;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.97);
    transition:
      opacity 120ms var(--ease-out, ease-out) 100ms,
      transform 120ms var(--ease-out, ease-out) 100ms,
      visibility 0s linear 220ms;
  }
  .menu:focus-within .menu__list {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 180ms var(--ease-out, ease-out),
      transform 180ms var(--ease-out, ease-out),
      visibility 0s;
  }
  @media (hover: hover) and (pointer: fine) {
    .menu:hover .menu__list {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        opacity 180ms var(--ease-out, ease-out),
        transform 180ms var(--ease-out, ease-out),
        visibility 0s;
    }
  }
  /* touch: no hover to open it, so it stays a plain link */
  @media not ((hover: hover) and (pointer: fine)) {
    .menu__list {
      display: none;
    }
  }
  .menu__list li {
    background: rgba(5, 12, 7, 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-inline: 1px solid var(--color-wtp-bramble, #2a4a33);
  }
  .menu__list li:first-child {
    border-top: 1px solid var(--color-wtp-bramble, #2a4a33);
    padding-top: 0.35rem;
  }
  .menu__list li:last-child {
    border-bottom: 1px solid var(--color-wtp-bramble, #2a4a33);
    padding-bottom: 0.35rem;
  }
  .site-header .menu__item {
    display: block;
    padding: 0.55rem 1rem;
    font-size: var(--type-xs);
    letter-spacing: 0.14em;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .site-header .menu__item:hover,
  .site-header .menu__item:focus-visible {
    color: var(--color-wtp-dawn, #f2c14e);
  }

  .site-header a:focus-visible {
    outline: 2px solid var(--color-wtp-dawn, #f2c14e);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* reduced motion: the fades stay, the movement goes */
  @media (prefers-reduced-motion: reduce) {
    .action,
    .action:active,
    .menu__caret,
    .menu__list {
      transform: none !important;
    }
    .action::after {
      transform: none;
    }
  }
</style>
