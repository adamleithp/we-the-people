---
// Fixed, transparent header: small wordmark left, the three sections right.
// Eases in behind the glass intro (`.fade-up` waits on html.intro-done).
---

<header class="site-header fade-up" style="--fade-delay:0.24s">
  <a class="wordmark" href="/">We the People</a>
  <nav>
    <a class="action" href="/problem"><span class="action__our">The </span>Problem</a>
    <a class="action" href="/hope"><span class="action__our">Our </span>Hope</a>
    <a class="action" href="/be-part-of-it">Be Part of It</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.35rem clamp(1.2rem, 4vw, 2.6rem);
    pointer-events: none; /* let the hero receive events; links re-enable below */
    /* night, frosted: page titles and photographs pass underneath without the
       nav sitting on top of them. Static, so the blur costs nothing per frame. */
    background: rgba(5, 12, 7, 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .site-header a {
    pointer-events: auto;
    text-decoration: none;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    color: var(--color-wtp-paper, #f6f4ee);
  }
  .wordmark {
    font-size: var(--type-display-sm);
    letter-spacing: 0.06em;
    line-height: 1;
  }
  nav {
    display: flex;
    gap: clamp(0.9rem, 3vw, 2rem);
  }
  .action {
    font-size: var(--type-xs);
    letter-spacing: 0.14em;
    white-space: nowrap;
    padding: 0.4rem 0.15rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .action:hover {
      border-color: var(--color-wtp-dawn, #f2c14e);
    }
  }
  .action:focus-visible {
    border-color: var(--color-wtp-dawn, #f2c14e);
  }
  /* fingers need 44px; the type stays small, the hit area grows */
  @media (pointer: coarse) {
    .action {
      display: grid;
      align-items: center;
      min-height: 2.75rem;
    }
  }
  /* phones: "Problem · Hope · Be Part of It" fits beside the wordmark, "The/Our …" doesn't */
  @media (max-width: 560px) {
    .action__our {
      display: none;
    }
  }
  .site-header a:focus-visible {
    outline: 2px solid var(--color-wtp-dawn, #f2c14e);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
