---
// Fixed, transparent header: small wordmark left, the three parts and
// Foundations right; on phones Foundations sits just under the three (ADA-68).
// Eases in behind the glass intro (`.fade-up` waits on html.intro-done).
// Be Part of It opens a menu of its three levels on hover or keyboard focus;
// on touch it is a plain link, since the page opens on the same three panels.
const LEVELS = [
  { id: 'you', label: 'You' },
  { id: 'community', label: 'Your Community' },
  { id: 'country', label: 'Our Country' },
];
---

<header class="site-header fade-up" style="--fade-delay:0.24s">
  <a class="wordmark" href="/">We the People</a>
  <nav>
    <div class="nav__row">
      <a class="action" href="/problem"><span class="action__our">The </span>Problem</a>
      <a class="action" href="/hope"><span class="action__our">Our </span>Hope</a>
      <div class="menu">
        <a class="action" href="/be-part-of-it">Be Part of It</a>
        <ul class="menu__list" aria-label="Be Part of It">
          {
            LEVELS.map((l) => (
              <li>
                <a class="menu__item" href={`/be-part-of-it#${l.id}`}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <a class="action action--under" href="/foundations">Foundations</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.35rem clamp(1.2rem, 4vw, 2.6rem);
    pointer-events: none; /* let the hero receive events; links re-enable below */
    /* night, frosted: page titles and photographs pass underneath without the
       nav sitting on top of them. Static, so the blur costs nothing per frame. */
    background: rgba(5, 12, 7, 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .site-header a {
    pointer-events: auto;
    text-decoration: none;
    font-family: var(--font-wordmark), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
    color: var(--color-wtp-paper, #f6f4ee);
  }
  .wordmark {
    font-size: var(--type-display-sm);
    letter-spacing: 0.06em;
    line-height: 1;
  }
  /* one row wherever the four fit. On phones there's no room beside the
     wordmark, so Foundations tucks in close under the three parts (ADA-68) */
  nav,
  .nav__row {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 2rem);
  }
  @media (max-width: 640px) {
    nav {
      flex-direction: column;
      gap: 0;
    }
    /* overlaps the row above's tap padding, so it reads as part of the nav */
    .site-header .action--under {
      margin-top: -0.7rem;
      padding-top: 0.3rem;
    }
  }
  .action {
    font-size: var(--type-xs);
    letter-spacing: 0.14em;
    white-space: nowrap;
    padding: 0.4rem 0.15rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .action:hover {
      border-color: var(--color-wtp-dawn, #f2c14e);
    }
  }
  .action:focus-visible {
    border-color: var(--color-wtp-dawn, #f2c14e);
  }
  /* fingers need 44px; the type stays small, the hit area grows */
  /* padding, not a grid, makes the 44px: a grid stacks "The" over "Problem" */
  @media (pointer: coarse) {
    .action {
      display: inline-block;
      padding-block: 0.9rem;
    }
  }
  /* phones: "Problem · Hope · Be Part of It" fits beside the wordmark, "The/Our …" doesn't */
  @media (max-width: 560px) {
    .action__our {
      display: none;
    }
  }
  /* --- Be Part of It's menu --------------------------------------------- */
  .menu {
    position: relative;
    display: flex;
  }
  /* hidden until hover or focus; the top padding bridges the gap under the
     link so the pointer can travel down into it without it closing */
  .menu__list {
    position: absolute;
    top: 100%;
    right: -1rem;
    margin: 0;
    padding: 0.9rem 0 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 150ms var(--ease-out, ease-out),
      transform 150ms var(--ease-out, ease-out),
      visibility 0s linear 150ms;
  }
  .menu__list li {
    background: rgba(5, 12, 7, 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-inline: 1px solid var(--color-wtp-bramble, #2a4a33);
  }
  .menu__list li:first-child {
    border-top: 1px solid var(--color-wtp-bramble, #2a4a33);
    padding-top: 0.35rem;
  }
  .menu__list li:last-child {
    border-bottom: 1px solid var(--color-wtp-bramble, #2a4a33);
    padding-bottom: 0.35rem;
  }
  .menu__item {
    display: block;
    padding: 0.55rem 1rem;
    font-size: var(--type-xs);
    letter-spacing: 0.14em;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .menu__item:hover,
  .menu__item:focus-visible {
    color: var(--color-wtp-dawn, #f2c14e) !important;
  }
  .menu:focus-within .menu__list {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  @media (hover: hover) and (pointer: fine) {
    .menu:hover .menu__list {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
  }
  /* touch: no hover to open it, so it stays a plain link */
  @media not ((hover: hover) and (pointer: fine)) {
    .menu__list {
      display: none;
    }
  }
  .site-header a:focus-visible {
    outline: 2px solid var(--color-wtp-dawn, #f2c14e);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
