---
/**
 * The page title as glass. At rest it is a plain <h1> — same font, same metrics,
 * so <GlassIntro>'s assembled wordmark still hands off to it untouched.
 *
 * As a pointer approaches, the heading is swapped for a stack of shard copies:
 * the same title repeated N times, each clipped to its own triangle (`shatter()`,
 * the geometry the intro uses). The swap is instantaneous and pixel-identical —
 * no crossfade, which is what would show the hairline seams between shards.
 *
 * The break is a *field*, not a hover target. Every shard reads its distance to
 * the pointer and folds by that much: the pieces under the cursor cave back into
 * the screen, tip their faces toward it and push outward, so a hole opens in the
 * wordmark and the portraits behind it come through. Falloff is smoothstep over
 * a radius, so the edge of the break is soft and the whole area moves as one.
 *
 * Faces come from `public/faces/` (portraits — the sad, ordinary faces of a
 * divided country). Until that folder has images it falls back to `public/hero/`.
 *
 * Performance:
 * - Shards are `pointer-events: none`; one window listener does the maths. No
 *   hit-testing of N clipped polygons.
 * - The frame loop writes three custom properties per shard (`--k`, `--ux`,
 *   `--uy`); CSS composes the transform and the three opacities from them, so
 *   only `transform`/`opacity` ever change.
 * - Shards outside the radius are skipped once they have settled at rest.
 * - Portraits are declared as a custom property and only promoted to a real
 *   `background-image` once a title is armed, so a page load fetches none.
 */
import { readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { shatter, mulberry32 } from '../lib/shards';

interface Props {
  /** the title, one entry per line */
  lines: string[];
  /** grid the title is broken on — cols × rows × 2 triangles */
  cols?: number;
  rows?: number;
}
const { lines, cols = 8, rows = 3 } = Astro.props;

const pick = (folder: string) => {
  try {
    return readdirSync(fileURLToPath(new URL(`../../public/${folder}`, import.meta.url)))
      .filter((f) => /\.(jpe?g|png|webp|avif)$/i.test(f))
      .sort()
      .map((f) => `/${folder}/${f}`);
  } catch {
    return [];
  }
};
const faces = pick('faces').length ? pick('faces') : pick('hero');

const shards = shatter(cols, rows, 20260804);
const html = lines.join('<br />');

/**
 * Per-piece character for the fold. Direction is decided at runtime (it points
 * away from the pointer), so what is baked here is only *how much* — how far
 * this piece pushes, how deep it caves, how hard it tips and twists.
 */
const rnd = mulberry32(9184);
const rand = (a: number, b: number) => a + rnd() * (b - a);
const fold = shards.map(() => ({
  push: rand(9, 26).toFixed(1), // px, outward from the pointer
  dz: -rand(38, 132).toFixed(0), // px, back into the screen
  tilt: rand(26, 50).toFixed(1), // deg at full strength, per unit direction
  spin: rand(-16, 16).toFixed(1), // deg of in-plane twist
  shrink: rand(0.04, 0.13).toFixed(3),
  dim: rand(0.4, 0.86).toFixed(2), // how much light this plate keeps
}));
---

<div class="stitle" data-shatter-title>
  <h1 class="wtp-wordmark stitle__base" set:html={html} />
  <div class="stitle__glass" aria-hidden="true">
    {
      shards.map((s, i) => {
        const [cx, cy] = s.origin.split(' ');
        return (
          <div
            class="sshard"
            data-cx={parseFloat(cx)}
            data-cy={parseFloat(cy)}
            style={`clip-path:${s.clip};transform-origin:${s.origin};--push:${fold[i].push}px;--dz:${fold[i].dz}px;--tilt:${fold[i].tilt};--spin:${fold[i].spin};--shrink:${fold[i].shrink};--dim:${fold[i].dim};--face:url('${faces[i % faces.length]}')`}
          >
            {/* the glass plate: the portrait, dimmed, filling the piece */}
            <div class="sshard__face" />
            {/* two copies of the title, crossfaded: white → cut from the photo */}
            <p class="wtp-wordmark sshard__ink" set:html={html} />
            <p class="wtp-wordmark sshard__cut" set:html={html} />
          </div>
        );
      })
    }
  </div>
</div>

<style>
  .stitle {
    position: relative;
    display: grid;
    place-items: center;
  }
  .stitle__base {
    grid-area: 1 / 1;
  }
  /* the shard stack sits exactly on the heading: same box, same centring */
  .stitle__glass {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    perspective: 900px; /* the pieces fold in space, like glass caving in */
  }
  .sshard {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none; /* the field is driven by one window listener */
    backface-visibility: hidden;
    --k: 0; /* 0 at rest → 1 directly under the pointer */
    --ux: 0; /* unit vector from the pointer to this piece */
    --uy: 0;
    transform: translate3d(
        calc(var(--ux) * var(--push) * var(--k)),
        calc(var(--uy) * var(--push) * var(--k)),
        calc(var(--dz) * var(--k))
      )
      rotateX(calc(var(--uy) * var(--tilt) * var(--k) * 1deg))
      rotateY(calc(var(--ux) * var(--tilt) * var(--k) * -1deg))
      rotate(calc(var(--spin) * var(--k) * 1deg))
      scale(calc(1 - var(--shrink) * var(--k)));
  }
  .sshard :global(p) {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    margin: 0;
  }
  /* the white letters step aside as the piece folds */
  .sshard__ink {
    opacity: calc(1 - var(--k));
  }
  /* the photo cut out by the letterforms — this is the piece's own type */
  .sshard__cut {
    background-image: none;
    background-position: center;
    background-size: cover;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: var(--k);
  }
  /* a plate of the same photo, so the triangle reads as glass, not a hole.
     `--dim` is per-piece, so the planes read at different depths instead of
     flattening into one bright collage. */
  .sshard__face {
    grid-area: 1 / 1;
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    opacity: calc(var(--k) * var(--dim));
  }

  /* Desktop pointers only: the whole effect is a pointer field. */
  @media (hover: hover) and (pointer: fine) {
    /* the swap is instant and pixel-identical, so it reads as nothing happening */
    .stitle.is-live .stitle__base {
      visibility: hidden;
    }
    .stitle.is-live .stitle__glass {
      opacity: 1;
    }
    /* the portraits are fetched when a pointer first comes near, never on load */
    .stitle.is-armed .sshard__cut {
      background-image: var(--face);
    }
    /* the plate carries a scrim so the break stays sombre against the off-black */
    .stitle.is-armed .sshard__face {
      background-image: linear-gradient(rgba(8, 11, 9, 0.5), rgba(8, 11, 9, 0.5)),
        var(--face);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stitle__glass {
      display: none;
    }
  }
</style>

<script>
  /**
   * One frame loop for every shattered title on the page. Each shard eases its
   * own `--k` toward the pointer falloff, so the break opens and closes softly
   * rather than snapping to wherever the cursor jumped.
   */
  const FINE = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const CALM = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (FINE && !CALM) {
    type Piece = { el: HTMLElement; cx: number; cy: number; k: number; t: number };
    type Field = { root: HTMLElement; pieces: Piece[]; armed: boolean; live: boolean };

    const fields: Field[] = [...document.querySelectorAll<HTMLElement>('[data-shatter-title]')].map(
      (root) => ({
        root,
        armed: false,
        live: false,
        pieces: [...root.querySelectorAll<HTMLElement>('.sshard')].map((el) => ({
          el,
          cx: Number(el.dataset.cx) / 100,
          cy: Number(el.dataset.cy) / 100,
          k: 0,
          t: 0,
        })),
      }),
    );

    if (fields.length) {
      let px = -1e5;
      let py = -1e5;
      let running = false;

      const smooth = (t: number) => t * t * (3 - 2 * t);

      const frame = () => {
        let busy = false;

        for (const field of fields) {
          const box = field.root.getBoundingClientRect();
          // the break is a circle in page space, sized off the title
          const radius = Math.min(box.width * 0.34, 420);
          const near =
            px > box.left - radius * 1.6 &&
            px < box.right + radius * 1.6 &&
            py > box.top - radius * 1.6 &&
            py < box.bottom + radius * 1.6;

          if (near && !field.armed) {
            field.armed = true;
            field.root.classList.add('is-armed'); // start fetching the portraits
          }

          for (const piece of field.pieces) {
            // the shard's centroid, in page space
            const sx = box.left + piece.cx * box.width;
            const sy = box.top + piece.cy * box.height;
            const dx = sx - px;
            const dy = sy - py;
            const dist = Math.hypot(dx, dy) || 0.001;

            piece.t = near && dist < radius ? smooth(1 - dist / radius) : 0;
            piece.k += (piece.t - piece.k) * 0.18;

            if (piece.k < 0.002) {
              if (piece.k === 0) continue; // already at rest — nothing to write
              piece.k = 0;
            } else {
              busy = true;
            }

            const el = piece.el.style;
            el.setProperty('--k', piece.k.toFixed(3));
            el.setProperty('--ux', (dx / dist).toFixed(3));
            el.setProperty('--uy', (dy / dist).toFixed(3));
          }

          // the glass stack is only shown while something is actually folded
          const live = busy || near;
          if (live !== field.live) {
            field.live = live;
            field.root.classList.toggle('is-live', live);
          }
          if (near) busy = true;
        }

        running = busy;
        if (busy) requestAnimationFrame(frame);
      };

      const kick = () => {
        if (!running) {
          running = true;
          requestAnimationFrame(frame);
        }
      };

      addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
          px = e.clientX;
          py = e.clientY;
          kick();
        },
        { passive: true },
      );
      addEventListener(
        'pointerleave',
        () => {
          px = -1e5;
          py = -1e5;
          kick();
        },
        { passive: true },
      );
      addEventListener('scroll', kick, { passive: true });
    }
  }
</script>
