---
/**
 * The page title as glass. At rest it is a plain <h1> — same font, same metrics,
 * so <GlassIntro>'s assembled wordmark still hands off to it untouched.
 *
 * As a pointer approaches, the heading is swapped for a stack of shard copies:
 * the same title repeated N times, each clipped to its own triangle (`shatter()`,
 * the geometry the intro uses). The swap is instantaneous and pixel-identical —
 * no crossfade, which is what would show the hairline seams between shards.
 *
 * The break is a *field*, not a hover target. Every shard reads its distance to
 * the pointer and folds by that much: the pieces under the cursor cave back into
 * the screen, tip their faces toward it and push outward, so a hole opens in the
 * wordmark and the portraits behind it come through. Falloff is smoothstep over
 * a radius, so the edge of the break is soft and the whole area moves as one.
 *
 * Faces come from `src/assets/faces/` (portraits — the sad, ordinary faces of a
 * divided country). Until that folder has images it falls back to
 * `src/assets/hero/`. They are imported, not read out of `public/`, so Astro
 * resizes them: the originals are 4–40 megapixel Unsplash JPEGs, and a shard
 * plate is a few hundred pixels wide. Painting the originals meant decoding
 * ~160 MB of RGBA the first time a title was hovered — an ~800ms stall, on top
 * of 22 MB of downloads.
 *
 * PERFORMANCE — this used to be the laggiest thing on the site. Three fixes:
 *
 * 1. Each shard is sized to its own triangle's bounding box, with a stage-sized
 *    wrapper inside offset back into place (`shatter()` bakes the numbers). It
 *    used to be `inset: 0` — every shard a full-wordmark box holding a photo
 *    plate and two full-size copies of the title. That is N full-title rasters
 *    and, once promoted, N full-title GPU textures. Now the painted and
 *    composited area across all shards is ≈1× the title instead of N×.
 * 2. The frame loop writes `style.transform` and the three opacities directly.
 *    It used to write custom properties (`--k/--ux/--uy`) and let CSS `calc()`
 *    compose them — but a custom property is inherited, so each write dirtied
 *    the style of the shard *and its three children*: ~200 style recalcs per
 *    frame, on the main thread, none of it compositable.
 * 3. An idle title holds no compositor layer and paints nothing — no transform
 *    on any shard, and the whole stack is `visibility: hidden`. Promotion is
 *    then per-FIELD (`.is-live`), never per-piece: toggling `will-change` on
 *    shards as they crossed in and out of the break radius made Chrome build and
 *    discard layers several times a second, which measured as 200ms+ spikes.
 *
 * Still true: shards are `pointer-events: none` (one window listener does the
 * maths, no hit-testing of N polygons), the element rect is cached and only
 * re-read on scroll/resize, and portraits are held in a custom property and
 * only promoted to a real `background-image` once a title is armed, so a page
 * load fetches none.
 */
import { getImage } from 'astro:assets';
import { shatter, mulberry32 } from '../lib/shards';
import { INTRO, INTRO_SEED } from '../lib/intro';

interface Props {
  /** the title, one entry per line */
  lines: string[];
  /** grid the title is broken on — cols × rows × 2 triangles */
  cols?: number;
  rows?: number;
  /** fly the title together from glass as its hero (`--hero`) scrolls in —
   *  the intro's shatter, on the scroll timeline instead of the clock */
  assemble?: boolean;
}
const { lines, cols = 6, rows = 3, assemble = false } = Astro.props;

/* Both folders are globbed at build time; dropping a file into `faces/` is
   still the whole job. Sorted so rebuilds stay byte-stable. */
const sorted = (mod: Record<string, { default: ImageMetadata }>) =>
  Object.keys(mod)
    .sort()
    .map((k) => mod[k].default);

const inFaces = sorted(
  import.meta.glob<{ default: ImageMetadata }>('../assets/faces/*.{jpg,jpeg,png,webp,avif}', {
    eager: true,
  }),
);
const inHero = sorted(
  import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.{jpg,jpeg,png,webp,avif}', {
    eager: true,
  }),
);

/* A shard plate is at most the width of the wordmark, so ~1100px covers it at
   2× DPR. Anything larger is decode cost with nothing on screen to show for it. */
const faces = await Promise.all(
  (inFaces.length ? inFaces : inHero).map((src) =>
    getImage({ src, width: 1100, format: 'webp', quality: 62 }).then((i) => i.src),
  ),
);

const shards = shatter(cols, rows, 20260804);
// the intro's own pieces and throw, so it reads as the same glass
const flight = assemble ? shatter(INTRO.hero.cols, INTRO.hero.rows, INTRO_SEED) : [];
const maxDelay = Math.max(0.001, ...flight.map((s) => s.delay));
const html = lines.join('<br />');

/**
 * Per-piece character for the fold. Direction is decided at runtime (it points
 * away from the pointer), so what is baked here is only *how much* — how far
 * this piece pushes, how deep it caves, how hard it tips and twists.
 */
const rnd = mulberry32(9184);
const rand = (a: number, b: number) => a + rnd() * (b - a);
const fold = shards.map(() => ({
  push: rand(9, 26).toFixed(1), // px, outward from the pointer
  dz: -rand(38, 132).toFixed(0), // px, back into the screen
  tilt: rand(26, 50).toFixed(1), // deg at full strength, per unit direction
  spin: rand(-16, 16).toFixed(1), // deg of in-plane twist
  shrink: rand(0.04, 0.13).toFixed(3),
  dim: rand(0.4, 0.86).toFixed(2), // how much light this plate keeps
}));
---

<div class:list={['stitle', { 'stitle--assemble': assemble }]} data-shatter-title>
  <h1 class="wtp-wordmark stitle__base" set:html={html} />
  {
    assemble && (
      <div class="stitle__flight" aria-hidden="true">
        {flight.map((s) => (
          <div
            class="fshard"
            style={`left:${s.bx.toFixed(4)}%;top:${s.by.toFixed(4)}%;width:${s.bw.toFixed(4)}%;height:${s.bh.toFixed(4)}%;clip-path:${s.clip};transform-origin:${s.origin};--tx:${s.tx.toFixed(1)}vw;--ty:${s.ty.toFixed(1)}vh;--rz:${s.rz.toFixed(1)}deg;--rx:${s.rx.toFixed(1)}deg;--ry:${s.ry.toFixed(1)}deg;--sc:${s.sc.toFixed(2)};--dn:${(s.delay / maxDelay).toFixed(3)}`}
          >
            <div
              class="sshard__in"
              style={`left:${s.ox.toFixed(4)}%;top:${s.oy.toFixed(4)}%;width:${s.sw.toFixed(4)}%;height:${s.sh.toFixed(4)}%;`}
            >
              <p class="wtp-wordmark" set:html={html} />
            </div>
          </div>
        ))}
      </div>
    )
  }
  <div class="stitle__glass" aria-hidden="true">
    {
      shards.map((s, i) => (
        <div
          class="sshard"
          data-cx={s.cx.toFixed(3)}
          data-cy={s.cy.toFixed(3)}
          data-push={fold[i].push}
          data-dz={fold[i].dz}
          data-tilt={fold[i].tilt}
          data-spin={fold[i].spin}
          data-shrink={fold[i].shrink}
          data-dim={fold[i].dim}
          style={`left:${s.bx.toFixed(4)}%;top:${s.by.toFixed(4)}%;width:${s.bw.toFixed(4)}%;height:${s.bh.toFixed(4)}%;clip-path:${s.clip};transform-origin:${s.origin};--face:url('${faces[i % faces.length]}')`}
        >
          <div
            class="sshard__in"
            style={`left:${s.ox.toFixed(4)}%;top:${s.oy.toFixed(4)}%;width:${s.sw.toFixed(4)}%;height:${s.sh.toFixed(4)}%;`}
          >
            {/* the glass plate: the portrait, dimmed, filling the piece */}
            <div class="sshard__face" />
            {/* two copies of the title, crossfaded: white → cut from the photo */}
            <p class="wtp-wordmark sshard__ink" set:html={html} />
            <p class="wtp-wordmark sshard__cut" set:html={html} />
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .stitle {
    position: relative;
    display: grid;
    place-items: center;
  }
  .stitle__base {
    grid-area: 1 / 1;
  }
  /* The shard stack is centred on the heading, like it, but bleeds past its
     box on every side. Anton's caps rise ~0.02em above a 0.84 line box, so a
     stack cut to the heading's own box sliced the tops off the letters; the
     bleed is equal all round, so the centred copies still land on the same
     pixels. `visibility: hidden` (not just opacity: 0) so an idle title
     paints nothing at all — the stack is a few dozen clipped photo plates. */
  .stitle__glass,
  .stitle__flight {
    position: absolute;
    inset: calc(var(--wordmark-size, 1em) * -0.12);
  }
  .stitle__glass {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    perspective: 900px; /* the pieces fold in space, like glass caving in */
  }
  /* Sized to its own triangle (inline left/top/width/height). `overflow: hidden`
     is what caps the raster: without it the stage-sized child inflates the paint
     and layer bounds straight back to the full wordmark. */
  .sshard {
    position: absolute;
    overflow: hidden;
    pointer-events: none; /* the field is driven by one window listener */
    /* no transform at rest: an idle title holds no compositor layer at all */
  }
  /* Promotion is per-FIELD, not per-piece. Toggling `will-change` on individual
     shards as they cross in and out of the break radius makes Chrome build and
     throw away a layer several times a second — measured as 200ms+ frame spikes.
     Arming the whole stack once, while the pointer is anywhere near, costs a few
     dozen triangle-sized textures and no churn. */
  .stitle.is-live .sshard {
    will-change: transform;
  }
  /* the stage, put back exactly where it was, so the title lands on the same
     pixels it would inside a full-size shard */
  .sshard__in {
    position: absolute;
    display: grid;
    place-items: center;
  }
  .sshard :global(p) {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    margin: 0;
  }
  /* the white letters step aside as the piece folds (opacity written by JS) */
  .sshard__ink {
    opacity: 1;
  }
  /* the photo cut out by the letterforms — this is the piece's own type */
  .sshard__cut {
    background-image: none;
    background-position: center;
    background-size: cover;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0;
  }
  /* a plate of the same photo, so the triangle reads as glass, not a hole.
     `--dim` is per-piece, so the planes read at different depths instead of
     flattening into one bright collage. */
  .sshard__face {
    grid-area: 1 / 1;
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    opacity: 0;
  }

  /* Desktop pointers only: the whole effect is a pointer field. */
  @media (hover: hover) and (pointer: fine) {
    /* The swap waits for the first piece to actually move (`is-broken`), not
       for the pointer to come near (`is-live`, which only arms the layers).
       Promoted, perspective-projected copies never rasterise quite like the
       flat heading — a fraction of a pixel off, a touch softer — and swapping
       on approach showed that on a title that hadn't moved yet. */
    .stitle.is-broken .stitle__base {
      visibility: hidden;
    }
    .stitle.is-broken .stitle__glass {
      opacity: 1;
      visibility: visible;
    }
    /* the portraits are fetched when a pointer first comes near, never on load */
    .stitle.is-armed .sshard__cut {
      background-image: var(--face);
    }
    /* the plate carries a scrim so the break stays sombre against the off-black */
    .stitle.is-armed .sshard__face {
      background-image: linear-gradient(rgba(8, 11, 9, 0.5), rgba(8, 11, 9, 0.5)),
        var(--face);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stitle__glass {
      display: none;
    }
  }

  /* --- assembling on scroll ------------------------------------------------ */
  /* The intro's `shard-assemble`, driven by the hero scrolling in rather than
     by the clock. Each piece's stagger becomes a later start on the scroll
     range (`--dn`, 0–1). The real heading stays hidden until the last piece is
     home, then the two swap in one step — pixel-identical, so no seam and no
     crossfade. Scrolling back up breaks it again. Without scroll timelines, or
     with reduced motion, there is no flight layer: the heading just sits. */
  .stitle__flight {
    display: none;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stitle__flight {
        display: block;
        pointer-events: none;
        perspective: 1200px;
        animation: flight-done step-end both;
        animation-timeline: --hero;
        animation-range: entry 0% entry 100%;
      }
      .stitle--assemble .stitle__base {
        animation: base-land step-end both;
        animation-timeline: --hero;
        animation-range: entry 0% entry 100%;
      }
      .fshard {
        position: absolute;
        overflow: hidden;
        backface-visibility: hidden;
        will-change: transform, opacity;
        animation: shard-assemble cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-timeline: --hero;
        animation-range: entry calc(5% + var(--dn) * 25%) entry calc(70% + var(--dn) * 30%);
      }
    }
  }
  @keyframes flight-done {
    to {
      visibility: hidden;
    }
  }
  @keyframes base-land {
    from {
      opacity: 0;
    }
  }
  /* same keyframes as GlassIntro's — keep the two in step */
  @keyframes shard-assemble {
    0% {
      opacity: 0;
      transform: translate3d(var(--tx), var(--ty), 0) rotate3d(1, 0, 0, var(--rx))
        rotate3d(0, 1, 0, var(--ry)) rotate(var(--rz)) scale(var(--sc));
    }
    10% {
      opacity: 1;
      transform: translate3d(var(--tx), var(--ty), 0) rotate3d(1, 0, 0, var(--rx))
        rotate3d(0, 1, 0, var(--ry)) rotate(var(--rz)) scale(var(--sc));
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  /**
   * One frame loop for every shattered title on the page. Each shard eases its
   * own fold toward the pointer falloff, so the break opens and closes softly
   * rather than snapping to wherever the cursor jumped.
   *
   * Everything per-frame is a direct `style.transform` / `style.opacity` write.
   * No custom properties: those inherit, so writing one dirties the shard's
   * whole subtree and forces a style recalc per child, per frame.
   */
  const FINE = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const CALM = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (FINE && !CALM) {
    type Piece = {
      el: HTMLElement;
      ink: HTMLElement | null;
      cut: HTMLElement | null;
      face: HTMLElement | null;
      cx: number;
      cy: number;
      push: number;
      dz: number;
      tilt: number;
      spin: number;
      shrink: number;
      dim: number;
      k: number;
      on: boolean;
    };
    type Field = {
      root: HTMLElement;
      /** the shard stack: piece centroids are fractions of its box, not the title's */
      stage: HTMLElement;
      pieces: Piece[];
      box: DOMRect;
      armed: boolean;
      live: boolean;
      broken: boolean;
    };

    const num = (el: HTMLElement, key: string) => Number(el.dataset[key]) || 0;

    const fields: Field[] = [
      ...document.querySelectorAll<HTMLElement>('[data-shatter-title]'),
    ].map((root) => {
      const stage = root.querySelector<HTMLElement>('.stitle__glass') ?? root;
      return {
        root,
        stage,
        box: stage.getBoundingClientRect(),
        armed: false,
        live: false,
        broken: false,
        pieces: [...root.querySelectorAll<HTMLElement>('.sshard')].map((el) => ({
          el,
          ink: el.querySelector<HTMLElement>('.sshard__ink'),
          cut: el.querySelector<HTMLElement>('.sshard__cut'),
          face: el.querySelector<HTMLElement>('.sshard__face'),
          cx: num(el, 'cx') / 100,
          cy: num(el, 'cy') / 100,
          push: num(el, 'push'),
          dz: num(el, 'dz'),
          tilt: num(el, 'tilt'),
          spin: num(el, 'spin'),
          shrink: num(el, 'shrink'),
          dim: num(el, 'dim'),
          k: 0,
          on: false,
        })),
      };
    });

    if (fields.length) {
      let px = -1e5;
      let py = -1e5;
      let running = false;
      // the element rect only moves on scroll/resize, so it is read then — not
      // once per field per frame, which would force layout inside the loop
      let boxesDirty = true;

      const smooth = (t: number) => t * t * (3 - 2 * t);

      /** put a piece back to rest — the CSS resting state, no inline styles */
      const rest = (p: Piece) => {
        p.on = false;
        p.el.style.transform = '';
        if (p.ink) p.ink.style.opacity = '';
        if (p.cut) p.cut.style.opacity = '';
        if (p.face) p.face.style.opacity = '';
      };

      const frame = () => {
        if (boxesDirty) {
          for (const field of fields) field.box = field.stage.getBoundingClientRect();
          boxesDirty = false;
        }

        let busy = false;

        for (const field of fields) {
          const box = field.box;
          // the break is a circle in page space, sized off the title
          const radius = Math.min(box.width * 0.34, 420) || 1;
          const r2 = radius * radius;
          const reach = radius * 1.6;
          const near =
            px > box.left - reach &&
            px < box.right + reach &&
            py > box.top - reach &&
            py < box.bottom + reach;

          if (near && !field.armed) {
            field.armed = true;
            field.root.classList.add('is-armed'); // start fetching the portraits
          }

          let folded = false;

          for (const p of field.pieces) {
            // the shard's centroid, in page space
            const dx = box.left + p.cx * box.width - px;
            const dy = box.top + p.cy * box.height - py;
            const d2 = dx * dx + dy * dy;

            let dist = 0;
            let t = 0;
            if (near && d2 < r2) {
              dist = Math.sqrt(d2) || 0.001;
              t = smooth(1 - dist / radius);
            }

            const k = p.k + (t - p.k) * 0.18;

            if (k < 0.002) {
              p.k = 0;
              if (p.on) rest(p); // settled — hand it back to the CSS resting state
              continue;
            }

            p.k = k;
            folded = true;
            p.on = true;

            if (!dist) dist = Math.sqrt(d2) || 0.001;
            const ux = dx / dist;
            const uy = dy / dist;
            const kp = p.push * k;

            p.el.style.transform =
              `translate3d(${(ux * kp).toFixed(2)}px,${(uy * kp).toFixed(2)}px,${(p.dz * k).toFixed(1)}px)` +
              ` rotateX(${(uy * p.tilt * k).toFixed(2)}deg)` +
              ` rotateY(${(-ux * p.tilt * k).toFixed(2)}deg)` +
              ` rotate(${(p.spin * k).toFixed(2)}deg)` +
              ` scale(${(1 - p.shrink * k).toFixed(4)})`;

            if (p.ink) p.ink.style.opacity = (1 - k).toFixed(3);
            if (p.cut) p.cut.style.opacity = k.toFixed(3);
            if (p.face) p.face.style.opacity = (k * p.dim).toFixed(3);
          }

          // layers are armed as the pointer nears; the glass is only shown
          // while something is actually folded
          const live = folded || near;
          if (live !== field.live) {
            field.live = live;
            field.root.classList.toggle('is-live', live);
          }
          if (folded !== field.broken) {
            field.broken = folded;
            field.root.classList.toggle('is-broken', folded);
          }
          if (live) busy = true;
        }

        running = busy;
        if (busy) requestAnimationFrame(frame);
      };

      const kick = () => {
        if (!running) {
          running = true;
          requestAnimationFrame(frame);
        }
      };

      addEventListener(
        'pointermove',
        (e) => {
          if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
          px = e.clientX;
          py = e.clientY;
          kick();
        },
        { passive: true },
      );
      addEventListener(
        'pointerleave',
        () => {
          px = -1e5;
          py = -1e5;
          kick();
        },
        { passive: true },
      );
      addEventListener(
        'scroll',
        () => {
          boxesDirty = true;
          kick();
        },
        { passive: true },
      );
      addEventListener('resize', () => {
        boxesDirty = true;
        kick();
      });
      // the wordmark box changes size when the display font arrives
      document.fonts?.ready.then(() => {
        boxesDirty = true;
      });
    }
  }
</script>
