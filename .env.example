# PostHog — project "We The People" (EU cloud). Copy to .env and fill in.
# Project settings → Project API key.
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
# Once the managed reverse proxy is verified, this becomes
# https://e.wethepeoplegather.com — a first-party domain ad blockers don't list.
# Until then it must stay on eu.i.posthog.com, or every event is dropped.
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
